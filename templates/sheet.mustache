{{!
    @template local_oksigeniahechauka/sheet

    A screen's sheet: the screen on the left, as the preview draws it or as it really is, with its facts; on the right,
    a card per topic. The save bar appears with the first change.

    Example context (json):
    {
        "style": "", "id": 3, "name": "Biblioteca", "rawname": "Biblioteca", "back": "#", "backlabel": "Pantallas y grupos",
        "backicon": "", "action": "#", "sesskey": "abc",
        "card": {"state": "on", "label": "En marcha", "meta": "señal hace 1 min"},
        "downhelp": false, "reload": "", "reloadicon": "", "clockhint": "", "clockicon": "", "moment": "Ahora · lunes 2, 10:45", "frame": "#",
        "vertical": false, "shot": "", "shotwhen": "",
        "facts": [{"term": "Señal", "value": "Hace 1 min"}],
        "groups": [{"id": 1, "name": "Zonas comunes", "checked": true}], "hasgroups": true,
        "power": {"always": false, "windows": [{"i": 0, "n": 1, "days": [{"n": 1, "letter": "L", "name": "lunes", "on": true},
            {"n": 6, "letter": "S", "name": "sábado", "on": false}], "on": "07:30", "off": "18:30"}],
            "bars": [{"letter": "L", "segments": [{"left": 31.25, "right": 22.92}]}],
            "sentence": "Encendida de lunes a viernes, de 07:30 a 18:30."}, "alerts": true, "sound": false, "uses": [], "plan": {"on": false, "days": [], "from": "00:00", "until": "23:59", "uses": []}, "distances": [], "glass": false, "canteen": {"on": true}, "place": {"name": "Biblioteca", "on": true, "maxlength": 40, "asks": true, "feminine": true, "masculine": false, "rows": [{"i": 0, "n": 1, "days": [{"n": 1, "letter": "L", "name": "lunes", "on": true}], "from": "08:00", "until": "17:00", "hidden": false, "removable": false, "remove": "Quitar el horario 1"}], "closed": [{"day": "2026-12-08"}], "xicon": ""}, "surprises": {"centreon": false, "on": true, "now": "", "centre": ""},
        "themes": [{"value": "site", "label": "Como el sitio", "checked": true}], "remove": "#",
        "errors": {}, "haserrors": false, "strings": "{}"
    }
}}
<div class="hkp" id="hkp-sheet-page"{{#style}} style="{{style}}"{{/style}} data-strings="{{strings}}">
    <a class="hkp-back" href="{{back}}">{{{backicon}}}{{backlabel}}</a>
    <header class="hkp-head">
        <div class="hkp-head-title"><h1>{{name}}</h1>{{#card}}<p class="hkp-head-sub"><span class="hkp-state" data-state="{{state}}"><span class="hkp-state-word"><span class="hkp-dot" aria-hidden="true"></span>{{label}}</span>{{#meta}} <span class="hkp-meta">{{meta}}</span>{{/meta}}</span></p>{{/card}}{{#clockhint}}<p class="hkp-head-sub hkp-hint">{{clockhint}}</p>{{/clockhint}}</div>
        {{#reload}}<div class="hkp-head-actions"><a class="btn btn-outline-secondary" href="{{reload}}">{{{reloadicon}}}{{#str}}reload, local_oksigeniahechauka{{/str}}</a></div>{{/reload}}
    </header>
    {{#haserrors}}<div class="alert alert-danger" role="alert">{{#str}}compose_errors, local_oksigeniahechauka{{/str}}</div>{{/haserrors}}
    <form method="post" action="{{action}}" id="hkp-sheet-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#downhelp}}<div class="alert alert-warning" role="status"><b>{{#str}}sheet_down_title, local_oksigeniahechauka{{/str}}</b> {{#str}}sheet_down_help, local_oksigeniahechauka{{/str}}</div>{{/downhelp}}
        <div class="hkp-sheet">
            <section class="hkp-sheet-screen hkp-card" aria-label="{{#str}}sheet_screen, local_oksigeniahechauka{{/str}}">
                <div class="hkp-preview-tools"><div class="hkp-seg" role="group" aria-label="{{#str}}sheet_see, local_oksigeniahechauka{{/str}}"><button type="button" aria-pressed="true" data-see="pv">{{#str}}preview, local_oksigeniahechauka{{/str}}</button><button type="button" aria-pressed="false" data-see="real">{{#str}}sheet_real, local_oksigeniahechauka{{/str}}</button></div><span class="hkp-clock">{{{clockicon}}}{{moment}}</span></div>
                <div id="hkp-see-pv"><div class="hkp-stage"><span class="hkp-bezel{{#vertical}} is-v{{/vertical}}" data-state="on"><iframe id="hkp-spv" src="{{frame}}" title="{{#str}}preview_of, local_oksigeniahechauka, {{name}}{{/str}}"></iframe><span class="hkp-led" aria-hidden="true"></span></span></div></div>
                <div id="hkp-see-real" hidden>
                    {{#shot}}<div class="hkp-stage"><span class="hkp-bezel{{#vertical}} is-v{{/vertical}}" data-state="on" role="img" aria-label="{{#str}}picture_alt, local_oksigeniahechauka, {{name}}{{/str}}"><img src="{{shot}}" alt=""><span class="hkp-led" aria-hidden="true"></span></span></div><p class="hkp-hint">{{shotwhen}}</p>{{/shot}}
                    {{^shot}}<p class="hkp-hint">{{#str}}sheet_noshot, local_oksigeniahechauka{{/str}}</p>{{/shot}}
                </div>
                <dl class="hkp-facts">{{#facts}}<div><dt>{{term}}</dt><dd>{{value}}</dd></div>{{/facts}}{{#device}}<div><dt>{{term}}</dt><dd>{{value}}</dd></div>{{/device}}</dl>
            </section>
            <div class="hkp-sheet-settings">
                <section class="hkp-card"><h2>{{#str}}sheet_namegroups, local_oksigeniahechauka{{/str}}</h2>
                    <div class="hkp-field"><label class="form-label" for="hkp-sn">{{#str}}name, local_oksigeniahechauka{{/str}}</label><input class="form-control{{#errors.name}} is-invalid{{/errors.name}}" id="hkp-sn" name="name" value="{{rawname}}" maxlength="100" autocomplete="off" required>{{#errors.name}}<p class="hkp-hint"><b class="text-danger">{{errors.name}}</b></p>{{/errors.name}}</div>
                    {{#hasgroups}}<div class="hkp-field"><span class="hkp-label">{{#str}}groups, local_oksigeniahechauka{{/str}}</span><div class="hkp-chips">{{#groups}}<label class="hkp-chip is-small"><input type="checkbox" name="groups[]" value="{{id}}"{{#checked}} checked{{/checked}}>{{name}}</label>{{/groups}}</div><p class="hkp-hint">{{#str}}sheet_groups_help, local_oksigeniahechauka{{/str}}</p></div>{{/hasgroups}}
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_use, local_oksigeniahechauka{{/str}}</h2>
                    <div class="hkp-uses" role="radiogroup" aria-label="{{#str}}sheet_use, local_oksigeniahechauka{{/str}}">{{#uses}}<label class="hkp-use"><input type="radio" name="screenuse" value="{{value}}"{{#checked}} checked{{/checked}}><span><b>{{label}}</b><small>{{help}}</small></span></label>{{/uses}}</div>
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-plan" name="planon" value="1"{{#plan.on}} checked{{/plan.on}}><div><label class="form-check-label" for="hkp-plan"><b>{{#str}}sheet_useplan, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_useplan_help, local_oksigeniahechauka{{/str}}</p></div></div>
                    <div id="hkp-plan-box"{{^plan.on}} hidden{{/plan.on}}>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-pl-l">{{#str}}compose_days, local_oksigeniahechauka{{/str}}</span><div class="hkp-days" role="group" aria-labelledby="hkp-pl-l">{{#plan.days}}<button type="button" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}" data-plan-day="{{n}}" aria-label="{{name}}">{{letter}}</button>{{/plan.days}}</div><div id="hkp-plan-inputs">{{#plan.days}}{{#on}}<input type="hidden" name="plandays[]" value="{{n}}">{{/on}}{{/plan.days}}</div></div>
                        <div class="hkp-time"><label for="hkp-pf">{{#str}}compose_hour_from, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-pf" name="planfrom" value="{{plan.from}}"><label for="hkp-pu">{{#str}}compose_hour_to, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-pu" name="planuntil" value="{{plan.until}}"></div>
                        <div class="hkp-field"><label class="form-label" for="hkp-puse">{{#str}}sheet_useplan_use, local_oksigeniahechauka{{/str}}</label><select class="form-select" id="hkp-puse" name="planuse">{{#plan.uses}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/plan.uses}}</select></div>
                        {{#errors.useplan}}<p class="hkp-hint"><b class="text-danger">{{errors.useplan}}</b></p>{{/errors.useplan}}
                    </div>
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_distance, local_oksigeniahechauka{{/str}}</h2>
                    <div class="hkp-uses" role="radiogroup" aria-label="{{#str}}sheet_distance, local_oksigeniahechauka{{/str}}">{{#distances}}<label class="hkp-use"><input type="radio" name="distance" value="{{value}}"{{#checked}} checked{{/checked}}><span><b>{{label}}</b><small>{{help}}</small></span></label>{{/distances}}</div>
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-glass" name="glass" value="1"{{#glass}} checked{{/glass}}><div><label class="form-check-label" for="hkp-glass"><b>{{#str}}sheet_glass, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_glass_help, local_oksigeniahechauka{{/str}}</p></div></div>
                    <p class="hkp-hint">{{#str}}sheet_distance_help, local_oksigeniahechauka{{/str}}</p>
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_place, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint">{{#str}}sheet_place_help, local_oksigeniahechauka{{/str}}</p>
                    {{#canteen}}<div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-canteen" name="canteen" value="1"{{#on}} checked{{/on}}><div><label class="form-check-label" for="hkp-canteen"><b>{{#str}}sheet_canteen, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_canteen_help, local_oksigeniahechauka{{/str}}</p></div></div>{{/canteen}}
                    <div class="hkp-field"><label class="form-label" for="hkp-placename">{{#str}}sheet_place_name, local_oksigeniahechauka{{/str}}</label><input class="form-control" id="hkp-placename" name="placename" maxlength="{{place.maxlength}}" value="{{place.name}}" placeholder="{{#str}}sheet_place_name_placeholder, local_oksigeniahechauka{{/str}}" autocomplete="off"></div>
                    <div id="hkp-place-box"{{^place.on}} hidden{{/place.on}}>
                        {{#place.asks}}<div class="hkp-field"><span class="hkp-label" id="hkp-pw-l">{{#str}}sheet_place_words, local_oksigeniahechauka{{/str}}</span><div class="hkp-chips" role="radiogroup" aria-labelledby="hkp-pw-l"><label class="hkp-chip is-small"><input type="radio" name="placewords" value="f"{{#place.feminine}} checked{{/place.feminine}}>{{#str}}sheet_place_words_f, local_oksigeniahechauka{{/str}}</label><label class="hkp-chip is-small"><input type="radio" name="placewords" value="m"{{#place.masculine}} checked{{/place.masculine}}>{{#str}}sheet_place_words_m, local_oksigeniahechauka{{/str}}</label></div></div>{{/place.asks}}
                        <div class="hkp-field hkp-cartel"><span class="hkp-label">{{#str}}sheet_place_hours, local_oksigeniahechauka{{/str}}</span>
                        {{#place.rows}}<fieldset class="hkp-place-row" data-place-row="{{i}}"{{#hidden}} hidden{{/hidden}}><legend class="visually-hidden sr-only">{{#str}}sheet_place_row, local_oksigeniahechauka, {{n}}{{/str}}</legend><div class="hkp-days" role="group" aria-label="{{#str}}compose_days, local_oksigeniahechauka{{/str}}">{{#days}}<button type="button" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}" data-place-day="{{n}}" aria-label="{{name}}">{{letter}}</button>{{/days}}</div><div data-place-inputs="{{i}}">{{#days}}{{#on}}<input type="hidden" name="placedays{{i}}[]" value="{{n}}">{{/on}}{{/days}}</div><div class="hkp-time"><label for="hkp-plf{{i}}">{{#str}}compose_hour_from, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-plf{{i}}" name="placefrom[{{i}}]" value="{{from}}"><label for="hkp-plu{{i}}">{{#str}}compose_hour_to, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-plu{{i}}" name="placeuntil[{{i}}]" value="{{until}}">{{#removable}}<button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-place-remove aria-label="{{remove}}" title="{{remove}}">{{{place.xicon}}}</button>{{/removable}}</div></fieldset>{{/place.rows}}
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="hkp-place-more">+ {{#str}}sheet_place_more, local_oksigeniahechauka{{/str}}</button></div>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-pc-l">{{#str}}sheet_place_closed, local_oksigeniahechauka{{/str}}</span><p class="hkp-hint">{{#str}}sheet_place_closed_help, local_oksigeniahechauka{{/str}}</p><ul class="hkp-closed" id="hkp-closed" aria-labelledby="hkp-pc-l">{{#place.closed}}<li><input class="form-control" type="date" name="placeclosed[]" value="{{day}}" aria-label="{{#str}}sheet_place_closed_day, local_oksigeniahechauka{{/str}}"><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-closed-remove aria-label="{{#str}}sheet_place_closed_remove, local_oksigeniahechauka{{/str}}" title="{{#str}}sheet_place_closed_remove, local_oksigeniahechauka{{/str}}">{{{place.xicon}}}</button></li>{{/place.closed}}</ul><template id="hkp-closed-new"><li><input class="form-control" type="date" name="placeclosed[]" value="" aria-label="{{#str}}sheet_place_closed_day, local_oksigeniahechauka{{/str}}"><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-closed-remove aria-label="{{#str}}sheet_place_closed_remove, local_oksigeniahechauka{{/str}}" title="{{#str}}sheet_place_closed_remove, local_oksigeniahechauka{{/str}}">{{{place.xicon}}}</button></li></template><button type="button" class="btn btn-sm btn-outline-secondary" id="hkp-closed-add">+ {{#str}}sheet_place_closed_add, local_oksigeniahechauka{{/str}}</button></div>
                        {{#errors.place}}<p class="hkp-hint"><b class="text-danger">{{errors.place}}</b></p>{{/errors.place}}
                    </div>
                </section>
                <section class="hkp-card"><h2>{{#str}}power, local_oksigeniahechauka{{/str}}</h2>
                    {{#power}}
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-always" name="always" value="1"{{#always}} checked{{/always}}><label class="form-check-label" for="hkp-always"><b>{{#str}}sheet_always, local_oksigeniahechauka{{/str}}</b></label></div>
                    <div id="hkp-power-hours"{{#always}} hidden{{/always}}>
                        <div id="hkp-power-rows">
                        {{#windows}}
                        <fieldset class="hkp-power-row" data-power-row="{{i}}">
                            <legend class="hkp-label" data-power-legend>{{#str}}sheet_power_row, local_oksigeniahechauka, {{n}}{{/str}}</legend>
                            <div class="hkp-days" role="group" aria-label="{{#str}}compose_days, local_oksigeniahechauka{{/str}}">{{#days}}<button type="button" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}" data-power-day="{{n}}" aria-label="{{name}}">{{letter}}</button>{{/days}}</div>
                            <input type="hidden" name="wdays[{{i}}]" value="{{#days}}{{#on}}{{n}},{{/on}}{{/days}}" data-power-days>
                            <div class="hkp-time"><label for="hkp-won{{i}}">{{#str}}compose_hour_from, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-won{{i}}" name="won[{{i}}]" value="{{on}}" data-power-on><label for="hkp-woff{{i}}">{{#str}}compose_hour_to, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-woff{{i}}" name="woff[{{i}}]" value="{{off}}" data-power-off><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-power-remove aria-label="{{#str}}sheet_power_remove, local_oksigeniahechauka, {{n}}{{/str}}" title="{{#str}}sheet_power_remove, local_oksigeniahechauka, {{n}}{{/str}}">{{{place.xicon}}}</button></div>
                            <p class="hkp-power-clash" data-power-clash role="status" hidden></p>
                        </fieldset>
                        {{/windows}}
                        </div>
                        {{! A new window, as the first one with no day on: the script gives it its index and its first free day. }}
                        <template id="hkp-power-new">{{#windows.0}}<fieldset class="hkp-power-row" data-power-row="__i__"><legend class="hkp-label" data-power-legend></legend><div class="hkp-days" role="group" aria-label="{{#str}}compose_days, local_oksigeniahechauka{{/str}}">{{#days}}<button type="button" aria-pressed="false" data-power-day="{{n}}" aria-label="{{name}}">{{letter}}</button>{{/days}}</div><input type="hidden" name="wdays[__i__]" value="" data-power-days><div class="hkp-time"><label for="hkp-won__i__">{{#str}}compose_hour_from, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-won__i__" name="won[__i__]" value="09:00" data-power-on><label for="hkp-woff__i__">{{#str}}compose_hour_to, local_oksigeniahechauka{{/str}}</label><input class="form-control" type="time" id="hkp-woff__i__" name="woff[__i__]" value="14:00" data-power-off><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-power-remove>{{{place.xicon}}}</button></div><p class="hkp-power-clash" data-power-clash role="status" hidden></p></fieldset>{{/windows.0}}</template>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="hkp-power-more">+ {{#str}}sheet_power_more, local_oksigeniahechauka{{/str}}</button>
                        {{#errors.power}}<p class="hkp-hint"><b class="text-danger">{{errors.power}}</b></p>{{/errors.power}}
                    </div>
                    <div class="hkp-power" id="hkp-power-bars" aria-hidden="true"{{#always}} hidden{{/always}}>{{#bars}}<b>{{letter}}</b><span>{{#segments}}<i style="left:{{left}}%;right:{{right}}%"></i>{{/segments}}</span>{{/bars}}<div class="hkp-power-scale"><span>0</span><span>6</span><span>12</span><span>18</span><span>24</span></div></div>
                    <p class="hkp-hint" id="hkp-power-sentence" aria-live="polite">{{sentence}}</p>
                    {{/power}}
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_ifdown, local_oksigeniahechauka{{/str}}</h2>
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-al" name="alerts" value="1"{{#alerts}} checked{{/alerts}}><div><label class="form-check-label" for="hkp-al"><b>{{#str}}sheet_alerts, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_alerts_help, local_oksigeniahechauka{{/str}}</p></div></div>
                </section>
                {{> local_oksigeniahechauka/sheet_touch }}
                <section class="hkp-card"><h2>{{#str}}sheet_sound_title, local_oksigeniahechauka{{/str}}</h2>
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-snd" name="sound" value="1"{{#sound}} checked{{/sound}}><div><label class="form-check-label" for="hkp-snd"><b>{{#str}}sheet_sound, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_sound_help, local_oksigeniahechauka{{/str}}</p></div></div>
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_theme, local_oksigeniahechauka{{/str}}</h2><div class="hkp-chips" role="radiogroup" aria-label="{{#str}}sheet_theme, local_oksigeniahechauka{{/str}}">{{#themes}}<label class="hkp-chip is-small"><input type="radio" name="theme" value="{{value}}"{{#checked}} checked{{/checked}}>{{label}}</label>{{/themes}}</div></section>
                <section class="hkp-card"><h2>{{#str}}sheet_surprises, local_oksigeniahechauka{{/str}}</h2>
                    {{#surprises.centreon}}<div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-surprises" name="surprises" value="1"{{#surprises.on}} checked{{/surprises.on}}><div><label class="form-check-label" for="hkp-surprises"><b>{{#str}}sheet_surprises_on, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}sheet_surprises_help, local_oksigeniahechauka, {{surprises.centre}}{{/str}}</p></div></div>
                    {{#surprises.now}}<a class="btn btn-sm btn-outline-secondary" href="{{surprises.now}}">{{#str}}sheet_surprise_now, local_oksigeniahechauka{{/str}}</a>{{/surprises.now}}{{/surprises.centreon}}
                    {{^surprises.centreon}}{{#surprises.on}}<input type="hidden" name="surprises" value="1">{{/surprises.on}}<p class="hkp-hint">{{#str}}sheet_surprises_off, local_oksigeniahechauka, {{surprises.centre}}{{/str}}</p>{{/surprises.centreon}}
                </section>
                <section class="hkp-card"><h2>{{#str}}sheet_device, local_oksigeniahechauka{{/str}}</h2><p>{{#str}}sheet_device_help, local_oksigeniahechauka, {{name}}{{/str}}</p></section>
                <section class="hkp-card is-danger"><h2>{{#str}}sheet_remove, local_oksigeniahechauka{{/str}}</h2><p>{{#str}}sheet_remove_help, local_oksigeniahechauka{{/str}}</p><p><a class="btn btn-outline-danger" href="{{remove}}">{{#str}}sheet_remove_button, local_oksigeniahechauka, {{name}}{{/str}}</a></p></section>
            </div>
        </div>
        <div class="hkp-savebar" id="hkp-savebar"{{^haserrors}} hidden{{/haserrors}} role="status"><p>{{#str}}sheet_unsaved, local_oksigeniahechauka{{/str}}</p><button type="submit" class="btn btn-primary">{{#str}}sheet_save, local_oksigeniahechauka{{/str}}</button><a class="btn btn-outline-secondary" href="{{action}}">{{#str}}sheet_undo, local_oksigeniahechauka{{/str}}</a></div>
    </form>
</div>
{{#js}}
(function() {
    var page = document.getElementById('hkp-sheet-page');
    if (!page) {
        return;
    }
    var form = page.querySelector('#hkp-sheet-form');
    var bar = page.querySelector('#hkp-savebar');
    var words = JSON.parse(page.getAttribute('data-strings') || '{}');
    var dirty = false;
    var changed = function() {
        dirty = true;
        bar.hidden = false;
        say();
    };
    var join = function(list) {
        return list.length < 2 ? (list[0] || '') : list.slice(0, -1).join(', ') + ' ' + words.and + ' ' + list[list.length - 1];
    };
    // The windows of the power: each its days and its two hours. Read from the page as they are now.
    var rows = function() {
        return Array.prototype.slice.call(page.querySelectorAll('[data-power-row]'));
    };
    var minutes = function(value) {
        var m = /^(\d{1,2}):(\d{2})/.exec(value || '');
        return m ? Number(m[1]) * 60 + Number(m[2]) : null;
    };
    var windowOf = function(row) {
        var days = [];
        row.querySelectorAll('[data-power-day][aria-pressed="true"]').forEach(function(b) {
            days.push(Number(b.getAttribute('data-power-day')));
        });
        var on = row.querySelector('[data-power-on]').value;
        var off = row.querySelector('[data-power-off]').value;
        return {row: row, days: days, on: on, off: off, from: minutes(on), to: minutes(off)};
    };
    // «de lunes a viernes», «todos los días», «los sábados», «los lunes y miércoles».
    var daysSaid = function(days) {
        if (days.length === 7) {
            return words.every;
        }
        if (days.join() === '1,2,3,4,5') {
            return words.weekdays;
        }
        return words.some.replace('{$a}', join(days.map(function(d) {
            return d > 5 ? words.plural[d - 6] : words.names[d - 1];
        })));
    };
    // The stretches of a window on each day, in minutes; one past midnight goes on into the next day.
    var stretches = function(w) {
        var out = [];
        if (w.from === null || w.to === null || w.from === w.to) {
            return out;
        }
        w.days.forEach(function(d) {
            if (w.from < w.to) {
                out.push({day: d, from: w.from, to: w.to});
            } else {
                out.push({day: d, from: w.from, to: 1440});
                out.push({day: d % 7 + 1, from: 0, to: w.to});
            }
        });
        return out;
    };
    var say = function() {
        var node = page.querySelector('#hkp-power-sentence');
        if (page.querySelector('#hkp-always').checked) {
            node.textContent = words.always;
            return;
        }
        var windows = rows().map(windowOf).filter(function(w) {
            return w.days.length;
        });
        var said = windows.map(function(w) {
            return words.window.replace('{$a->days}', daysSaid(w.days)).replace('{$a->from}', w.on).replace('{$a->to}', w.off);
        });
        // Three windows or more, apart by «;»: each one has a comma of its own.
        var all = said.length > 2 ? said.slice(0, -1).join('; ') + ' ' + words.and + ' ' + said[said.length - 1] : join(said);
        node.textContent = (said.length ? words.many.replace('{$a}', all) + ' ' : '') + words.rest;
        bars(windows);
        clashes(windows);
    };
    // The week in bars, Monday to Sunday, every window on it.
    var bars = function(windows) {
        var box = page.querySelector('#hkp-power-bars');
        var all = [];
        windows.forEach(function(w) {
            all = all.concat(stretches(w));
        });
        Array.prototype.forEach.call(box.children, function(child, k) {
            if (child.tagName !== 'SPAN') {
                return;
            }
            var day = (k + 1) / 2;
            child.textContent = '';
            all.filter(function(x) {
                return x.day === day;
            }).forEach(function(x) {
                var i = document.createElement('i');
                i.style.left = (x.from / 14.4) + '%';
                i.style.right = (100 - x.to / 14.4) + '%';
                child.appendChild(i);
            });
        });
    };
    // A day in two windows that meet: said on the later one, where it was touched, with the days and the other window.
    // The days two windows both light at the same hours.
    var shared = function(mine, theirs) {
        var days = [];
        mine.forEach(function(x) {
            theirs.forEach(function(y) {
                if (x.day === y.day && x.from < y.to && y.from < x.to && days.indexOf(x.day) < 0) {
                    days.push(x.day);
                }
            });
        });
        return days;
    };
    var clashes = function(windows) {
        rows().forEach(function(row) {
            var p = row.querySelector('[data-power-clash]');
            p.hidden = true;
            p.textContent = '';
            row.classList.remove('is-clash');
        });
        windows.forEach(function(w, b) {
            for (var a = 0; a < b; a++) {
                var days = shared(stretches(w), stretches(windows[a]));
                if (days.length) {
                    var p = w.row.querySelector('[data-power-clash]');
                    p.textContent = words.clash.replace('{$a->n}', rows().indexOf(windows[a].row) + 1)
                        .replace('{$a->days}', daysSaid(days.sort()));
                    p.hidden = false;
                    w.row.classList.add('is-clash');
                    return;
                }
            }
        });
    };
    page.querySelectorAll('[data-see]').forEach(function(b) {
        b.addEventListener('click', function() {
            page.querySelectorAll('[data-see]').forEach(function(x) {
                x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
            });
            page.querySelector('#hkp-see-pv').hidden = b.getAttribute('data-see') !== 'pv';
            page.querySelector('#hkp-see-real').hidden = b.getAttribute('data-see') === 'pv';
        });
    });
    // Each window: its days (never none), its hours, and its «×» while there is another; «+ Otro horario» adds one
    // with the first day no window has.
    var number = function() {
        var list = rows();
        list.forEach(function(row, k) {
            var legend = row.querySelector('[data-power-legend]');
            legend.textContent = words.row.replace('{$a}', k + 1);
            // With one window, its number says nothing to the eye: kept for a screen reader.
            legend.classList.toggle('visually-hidden', list.length < 2);
            legend.classList.toggle('sr-only', list.length < 2);
            var x = row.querySelector('[data-power-remove]');
            x.hidden = list.length < 2;
            x.setAttribute('aria-label', words.remove.replace('{$a}', k + 1));
            x.setAttribute('title', words.remove.replace('{$a}', k + 1));
        });
    };
    var keep = function(row) {
        var days = [];
        row.querySelectorAll('[data-power-day][aria-pressed="true"]').forEach(function(b) {
            days.push(b.getAttribute('data-power-day'));
        });
        row.querySelector('[data-power-days]').value = days.join(',');
    };
    var wire = function(row) {
        row.querySelectorAll('[data-power-day]').forEach(function(b) {
            b.addEventListener('click', function() {
                var on = b.getAttribute('aria-pressed') !== 'true';
                if (!on && row.querySelectorAll('[data-power-day][aria-pressed="true"]').length === 1) {
                    return;
                }
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
                keep(row);
                changed();
            });
        });
        row.querySelector('[data-power-remove]').addEventListener('click', function() {
            var at = rows().indexOf(row);
            row.remove();
            number();
            var next = rows()[Math.max(0, at - 1)];
            (next ? next.querySelector('[data-power-day]') : page.querySelector('#hkp-power-more')).focus();
            changed();
        });
        keep(row);
    };
    rows().forEach(wire);
    number();
    page.querySelector('#hkp-power-more').addEventListener('click', function() {
        var last = -1;
        rows().forEach(function(row) {
            last = Math.max(last, Number(row.getAttribute('data-power-row')));
        });
        var i = String(last + 1);
        var html = page.querySelector('#hkp-power-new').innerHTML.replace(/__i__/g, i);
        var box = page.querySelector('#hkp-power-rows');
        box.insertAdjacentHTML('beforeend', html);
        var row = box.lastElementChild;
        var taken = [];
        rows().forEach(function(r) {
            r.querySelectorAll('[data-power-day][aria-pressed="true"]').forEach(function(b) {
                taken.push(b.getAttribute('data-power-day'));
            });
        });
        var free = Array.prototype.filter.call(row.querySelectorAll('[data-power-day]'), function(b) {
            return taken.indexOf(b.getAttribute('data-power-day')) < 0;
        })[0] || row.querySelector('[data-power-day]');
        free.setAttribute('aria-pressed', 'true');
        wire(row);
        number();
        free.focus();
        changed();
    });
    page.querySelector('#hkp-always').addEventListener('change', function() {
        page.querySelector('#hkp-power-bars').hidden = this.checked;
        page.querySelector('#hkp-power-hours').hidden = this.checked;
    });
    // Another use at some hours: its days, kept in hidden inputs as the power's.
    page.querySelectorAll('[data-plan-day]').forEach(function(b) {
        b.addEventListener('click', function() {
            var on = b.getAttribute('aria-pressed') !== 'true';
            if (!on && page.querySelectorAll('[data-plan-day][aria-pressed="true"]').length === 1) {
                return;
            }
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            var box = page.querySelector('#hkp-plan-inputs');
            box.textContent = '';
            page.querySelectorAll('[data-plan-day][aria-pressed="true"]').forEach(function(x) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'plandays[]';
                input.value = x.getAttribute('data-plan-day');
                box.appendChild(input);
            });
            changed();
        });
    });
    page.querySelector('#hkp-plan').addEventListener('change', function() {
        page.querySelector('#hkp-plan-box').hidden = !this.checked;
    });
    // Where it is: the rest of the section only with a name, the days of each row of hours in hidden inputs (as the
    // power's), up to three rows, and the days it closes.
    var place = page.querySelector('#hkp-placename');
    var placebox = page.querySelector('#hkp-place-box');
    var guessed = !place.value;
    place.addEventListener('input', function() {
        placebox.hidden = !place.value.trim();
        var feminine = page.querySelector('input[name="placewords"][value="f"]');
        if (guessed && feminine) {
            var first = place.value.trim().split(/\s+/)[0].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            var f = /(a|cion|sion|dad|tad)$/.test(first);
            feminine.checked = f;
            page.querySelector('input[name="placewords"][value="m"]').checked = !f;
        }
    });
    page.querySelectorAll('input[name="placewords"]').forEach(function(input) {
        input.addEventListener('change', function() {
            guessed = false;
        });
    });
    var placeinputs = function(row) {
        var box = row.querySelector('[data-place-inputs]');
        var i = box.getAttribute('data-place-inputs');
        box.textContent = '';
        row.querySelectorAll('[data-place-day][aria-pressed="true"]').forEach(function(x) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'placedays' + i + '[]';
            input.value = x.getAttribute('data-place-day');
            box.appendChild(input);
        });
    };
    var more = page.querySelector('#hkp-place-more');
    var showmore = function() {
        more.hidden = !page.querySelector('[data-place-row][hidden]');
    };
    page.querySelectorAll('[data-place-row]').forEach(function(row) {
        row.querySelectorAll('[data-place-day]').forEach(function(b) {
            b.addEventListener('click', function() {
                b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
                placeinputs(row);
                changed();
            });
        });
        var remove = row.querySelector('[data-place-remove]');
        if (remove) {
            remove.addEventListener('click', function() {
                row.querySelectorAll('[data-place-day]').forEach(function(b) {
                    b.setAttribute('aria-pressed', 'false');
                });
                placeinputs(row);
                row.querySelectorAll('input[type="time"]').forEach(function(input) {
                    input.value = '';
                });
                row.hidden = true;
                showmore();
                more.focus();
                changed();
            });
        }
    });
    more.addEventListener('click', function() {
        var row = page.querySelector('[data-place-row][hidden]');
        if (row) {
            row.hidden = false;
            row.querySelector('[data-place-day]').focus();
        }
        showmore();
    });
    showmore();
    var closed = page.querySelector('#hkp-closed');
    closed.addEventListener('click', function(e) {
        var button = e.target.closest('[data-closed-remove]');
        if (button) {
            button.closest('li').remove();
            changed();
        }
    });
    page.querySelector('#hkp-closed-add').addEventListener('click', function() {
        closed.appendChild(page.querySelector('#hkp-closed-new').content.cloneNode(true));
        closed.lastElementChild.querySelector('input').focus();
    });
    say();
    form.addEventListener('input', changed);
    form.addEventListener('change', changed);
    form.addEventListener('submit', function() {
        dirty = false;
    });
    window.addEventListener('beforeunload', function(e) {
        if (dirty) {
            e.preventDefault();
            e.returnValue = '';
        }
    });
})();
{{/js}}
