{{!
    @template local_oksigeniahechauka/item_row

    A piece of content in the list: drawn with the screens' own pieces, then its title and meta, when it shows, where,
    and what the person may do with it.

    Example context (json):
    {
        "id": 7,
        "type": "notice",
        "mine": true,
        "title": "Salida temprana el viernes",
        "thumb": {"type": "notice", "isnotice": true, "important": true},
        "kind": "Aviso",
        "kindicon": "",
        "meta": [{"flag": true, "text": "Importante", "icon": ""}, {"text": "De Marta Gil"}],
        "when": "Hasta el viernes 6",
        "whensmall": "quedan 5 días",
        "soon": false,
        "where": "Todas las pantallas",
        "wheresmall": "",
        "clockicon": "",
        "screensicon": "",
        "actions": [{"url": "https://example.com/local/oksigeniahechauka/edit.php?id=7", "label": "Editar", "icon": ""}],
        "menu": ""
    }
}}
<li class="hkp-item" data-type="{{type}}" data-mine="{{#mine}}1{{/mine}}{{^mine}}0{{/mine}}">
    {{#thumb}}{{> local_oksigeniahechauka/item_thumb}}{{/thumb}}
    <div class="hkp-item-main">
        <h4 class="hkp-item-title">{{title}}</h4>
        <p class="hkp-item-meta"><span class="hkp-type">{{{kindicon}}}{{kind}}</span>{{#meta}}{{#flag}}<span class="hkp-flag">{{{icon}}}{{text}}</span>{{/flag}}{{^flag}}<span>{{text}}</span>{{/flag}}{{/meta}}</p>
    </div>
    <p class="hkp-item-when">{{{clockicon}}}<span class="visually-hidden sr-only">{{#str}}when_label, local_oksigeniahechauka{{/str}} </span><b>{{when}}</b>{{#whensmall}}<small{{#soon}} class="is-soon"{{/soon}}>{{whensmall}}</small>{{/whensmall}}</p>
    <p class="hkp-item-where">{{{screensicon}}}<span class="visually-hidden sr-only">{{#str}}where_label, local_oksigeniahechauka{{/str}} </span><span>{{where}}</span>{{#wheresmall}}<small>{{wheresmall}}</small>{{/wheresmall}}</p>
    <div class="hkp-item-actions">{{#actions}}<a class="btn btn-sm btn-outline-secondary" href="{{url}}">{{{icon}}}{{label}}</a>{{/actions}}{{{menu}}}</div>
</li>
