{{!
    @template local_oksigeniahechauka/proposal_button

    «Propose an improvement», beside a page's title: Oksigenia Marandu's piece opens it (data-marandu-proposal), with the
    page's name (data-screen).

    Example context (json):
    {
        "component": "local_oksigeniahechauka", "screen": "Tu centro", "label": "Proponer una mejora", "icon": ""
    }
}}
<button type="button" class="hkp-howto hkp-proposal" data-marandu-proposal="{{component}}" data-screen="{{screen}}">{{{icon}}}<span>{{label}}</span></button>
