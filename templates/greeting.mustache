{{!
    @template local_oksigeniahechauka/greeting

    The birthday card at the top of the dashboard of whoever has a birthday today, until they close it.

    Example context (json):
    {
        "firstname": "Lucía", "name": "Lucía Pérez", "group": "3.º A", "hasgroup": true, "photo": "", "hasphoto": false,
        "initial": "L", "action": "#", "sesskey": "abc", "back": "/my/"
    }
}}
<section class="hk-greeting" aria-labelledby="hk-greeting-title">
    <div class="hk-greeting-face" aria-hidden="true">{{#hasphoto}}<img src="{{photo}}" alt="">{{/hasphoto}}{{^hasphoto}}<span data-hk-bichito="{{name}}">{{initial}}</span>{{/hasphoto}}</div>
    <div class="hk-greeting-text">
        <h2 id="hk-greeting-title">{{#str}}greeting_title, local_oksigeniahechauka, {{firstname}}{{/str}}</h2>
        <p>{{#str}}greeting_body, local_oksigeniahechauka{{/str}}</p>
    </div>
    <form class="hk-greeting-close" method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="close" value="1"><input type="hidden" name="back" value="{{back}}">
        <button type="submit" class="btn-close" aria-label="{{#str}}greeting_close, local_oksigeniahechauka{{/str}}" title="{{#str}}greeting_close, local_oksigeniahechauka{{/str}}"></button>
    </form>
</section>
