{{!
    @template local_oksigeniahechauka/groups

    «Pantallas y grupos»: the screens in short rows, adding one (a dialog with the address for the TV and the code),
    and a card per group with its screens, who publishes in it and a search of the people of the school.

    Example context (json):
    {
        "style": "", "title": "Pantallas", "hastabs": false, "tabs": [], "action": "#", "sesskey": "abc",
        "rows": [], "count": 0, "groups": [], "groupcount": 0, "hasgroups": false, "everywhere": [], "haseverywhere": false, "managers": [],
        "hasmanagers": false, "choosemanagers": false,
        "player": "https://example.com/local/oksigeniahechauka/player/", "claim": "#", "people": "#", "admin": "",
        "icons": {"qr": "", "x": "", "plus": "", "search": "", "sliders": "", "copy": ""}, "strings": "{}"
    }
}}
<div class="hkp" id="hkp-groups-page"{{#style}} style="{{style}}"{{/style}} data-strings="{{strings}}" data-people="{{people}}" data-sesskey="{{sesskey}}">
    <header class="hkp-head"><div class="hkp-head-title"><h1>{{title}}</h1></div></header>
    {{#hastabs}}<nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">{{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}</nav>{{/hastabs}}
    <div class="hkp-gp">
    <div class="hkp-gp-main">
    <section aria-labelledby="hkp-h-scr">
        <div class="hkp-sec-head"><h2 id="hkp-h-scr">{{#str}}screens, local_oksigeniahechauka{{/str}}</h2><span class="hkp-count">{{count}}</span><div class="hkp-sec-tools"><button type="button" class="btn btn-primary" data-hkp-open="hkp-new-dialog">{{{icons.qr}}}{{#str}}addscreen_card, local_oksigeniahechauka{{/str}}</button></div></div>
        <ul class="hkp-glist">
            {{#rows}}<li><span class="hkp-mini"><span class="hkp-bezel{{#vertical}} is-v{{/vertical}}" data-state="{{state}}">{{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}{{^image}}<span class="hkp-bezel-off hkp-mini-icon" aria-hidden="true">{{{shapeicon}}}</span>{{/image}}<span class="hkp-led" aria-hidden="true"></span></span></span><span><b>{{name}}</b><span class="hkp-state" data-state="{{state}}"><span class="hkp-state-word"><span class="hkp-dot" aria-hidden="true"></span>{{label}}</span>{{#meta}} <span class="hkp-meta">· {{meta}}</span>{{/meta}}</span></span><span class="hkp-chips">{{#groupnames}}<span class="hkp-chip is-small hkp-static">{{name}}</span>{{/groupnames}}</span><a class="btn btn-sm btn-outline-secondary" href="{{sheet}}">{{{icons.sliders}}}{{#str}}groups_sheet, local_oksigeniahechauka{{/str}}</a></li>{{/rows}}
        </ul>
    </section>
    <section aria-labelledby="hkp-h-grp">
        <div class="hkp-sec-head"><h2 id="hkp-h-grp">{{#str}}groups, local_oksigeniahechauka{{/str}}</h2><span class="hkp-count">{{groupcount}}</span>{{#hasgroups}}<div class="hkp-sec-tools"><button type="button" class="btn btn-outline-secondary" data-hkp-open="hkp-group-dialog">{{{icons.plus}}}{{#str}}groups_new, local_oksigeniahechauka{{/str}}</button></div>{{/hasgroups}}<p class="hkp-hint hkp-sec-hint">{{#str}}groups_help, local_oksigeniahechauka{{/str}}</p></div>
        {{^hasgroups}}<div class="hkp-none"><p>{{#str}}groups_none, local_oksigeniahechauka{{/str}}</p><button type="button" class="btn btn-outline-secondary" data-hkp-open="hkp-group-dialog">{{{icons.plus}}}{{#str}}groups_new, local_oksigeniahechauka{{/str}}</button></div>{{/hasgroups}}
        <div class="hkp-groups">
            {{#groups}}
            <article class="hkp-group" id="hkp-group-{{id}}" data-list="group" data-group="{{id}}">
                <header><h3>{{name}}</h3>{{{menu}}}</header>
                <div><span class="hkp-k">{{#str}}groups_screens, local_oksigeniahechauka{{/str}}</span>
                    <div class="hkp-chips">
                        {{#screens}}<span class="hkp-chip is-small hkp-static">{{{icon}}}{{name}}<a class="hkp-chip-x" href="{{action}}?action=removemember&amp;group={{group}}&amp;screen={{id}}&amp;sesskey={{sesskey}}" aria-label="{{label}}">{{{icons.x}}}</a></span>{{/screens}}
                        {{#hasothers}}<details class="hkp-add"><summary class="hkp-chip is-small">{{{icons.plus}}}{{#str}}add, local_oksigeniahechauka{{/str}}</summary>
                            <form method="post" action="{{action}}" class="hkp-find"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="addmember"><input type="hidden" name="group" value="{{id}}"><label class="visually-hidden sr-only" for="hkp-add-{{id}}">{{#str}}groups_addscreen, local_oksigeniahechauka, {{name}}{{/str}}</label><select class="form-select" id="hkp-add-{{id}}" name="screen">{{#others}}<option value="{{id}}">{{name}}</option>{{/others}}</select><button type="submit" class="btn btn-outline-secondary">{{#str}}add, local_oksigeniahechauka{{/str}}</button></form>
                        </details>{{/hasothers}}
                    </div>
                </div>
                <div><span class="hkp-k">{{#str}}groups_people, local_oksigeniahechauka{{/str}}</span>
                    <ul class="hkp-people">
                        {{#people}}<li class="hkp-person"><span class="hkp-av" aria-hidden="true">{{initials}}</span><span>{{name}}{{#detail}}<small>{{detail}}</small>{{/detail}}</span><a class="btn btn-sm btn-outline-secondary btn-icon" href="#" data-remove-user="{{userid}}" aria-label="{{label}}">{{{icons.x}}}</a></li>{{/people}}
                        {{^haspeople}}<li class="hkp-hint">{{#str}}groups_nobody_yet, local_oksigeniahechauka{{/str}}</li>{{/haspeople}}
                    </ul>
                </div>
                <div class="hkp-search" data-list="group" data-group="{{id}}">{{{icons.search}}}<input class="form-control" role="combobox" aria-expanded="false" aria-controls="hkp-lb-{{id}}" aria-autocomplete="list" placeholder="{{#str}}groups_search, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}groups_search_label, local_oksigeniahechauka, {{name}}{{/str}}" autocomplete="off" spellcheck="false"><ul class="hkp-listbox" id="hkp-lb-{{id}}" role="listbox" aria-label="{{#str}}groups_found, local_oksigeniahechauka{{/str}}" hidden></ul></div>
            </article>
            {{/groups}}
        </div>
    </section>
    </div>
    <aside class="hkp-gp-side" aria-labelledby="hkp-h-perms">
        <div class="hkp-sec-head"><h2 id="hkp-h-perms">{{#str}}groups_permissions, local_oksigeniahechauka{{/str}}</h2><p class="hkp-hint hkp-sec-hint">{{#str}}groups_permissions_help, local_oksigeniahechauka{{/str}}</p></div>
        <article class="hkp-group is-perm" id="hkp-all" data-list="everywhere" data-group="0">
            <header class="is-stacked"><h3>{{#str}}groups_everywhere, local_oksigeniahechauka{{/str}}</h3><p class="hkp-hint">{{#str}}groups_everywhere_help, local_oksigeniahechauka{{/str}}</p></header>
            <ul class="hkp-people">
                {{#everywhere}}<li class="hkp-person"><span class="hkp-av" aria-hidden="true">{{initials}}</span><span>{{name}}{{#detail}}<small>{{detail}}</small>{{/detail}}</span>{{#own}}<a class="btn btn-sm btn-outline-secondary btn-icon" href="#" data-remove-user="{{userid}}" aria-label="{{label}}">{{{icons.x}}}</a>{{/own}}{{^own}}<span></span>{{/own}}</li>{{/everywhere}}
                            {{^haseverywhere}}<li class="hkp-hint">{{#str}}groups_nobody_else, local_oksigeniahechauka{{/str}}</li>{{/haseverywhere}}
            </ul>
            <div class="hkp-search" data-list="everywhere" data-group="0">{{{icons.search}}}<input class="form-control" role="combobox" aria-expanded="false" aria-controls="hkp-lb-everywhere" aria-autocomplete="list" placeholder="{{#str}}groups_search, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}groups_everywhere_search_label, local_oksigeniahechauka{{/str}}" autocomplete="off" spellcheck="false"><ul class="hkp-listbox" id="hkp-lb-everywhere" role="listbox" aria-label="{{#str}}groups_found, local_oksigeniahechauka{{/str}}" hidden></ul></div>
        </article>
        <article class="hkp-group is-perm" id="hkp-managers" data-list="managers" data-group="0">
            <header class="is-stacked"><h3>{{#str}}groups_managers, local_oksigeniahechauka{{/str}}</h3><p class="hkp-hint">{{#str}}groups_managers_help, local_oksigeniahechauka{{/str}}</p></header>
            <ul class="hkp-people">
                {{#managers}}<li class="hkp-person"><span class="hkp-av" aria-hidden="true">{{initials}}</span><span>{{name}}{{#detail}}<small>{{detail}}</small>{{/detail}}</span>{{#own}}<a class="btn btn-sm btn-outline-secondary btn-icon" href="#" data-remove-user="{{userid}}" aria-label="{{label}}">{{{icons.x}}}</a>{{/own}}{{^own}}<span></span>{{/own}}</li>{{/managers}}
                            {{^hasmanagers}}<li class="hkp-hint">{{#str}}groups_nobody_else, local_oksigeniahechauka{{/str}}</li>{{/hasmanagers}}
            </ul>
            {{#choosemanagers}}<div class="hkp-search" data-list="managers" data-group="0">{{{icons.search}}}<input class="form-control" role="combobox" aria-expanded="false" aria-controls="hkp-lb-managers" aria-autocomplete="list" placeholder="{{#str}}groups_search, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}groups_managers_search_label, local_oksigeniahechauka{{/str}}" autocomplete="off" spellcheck="false"><ul class="hkp-listbox" id="hkp-lb-managers" role="listbox" aria-label="{{#str}}groups_found, local_oksigeniahechauka{{/str}}" hidden></ul></div>{{/choosemanagers}}
            {{^choosemanagers}}<p class="hkp-hint">{{#str}}groups_managers_admin, local_oksigeniahechauka{{/str}}</p>{{/choosemanagers}}
        </article>
    </aside>
    </div>
    <form method="post" action="{{action}}" id="hkp-people-form" hidden><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="addeditor"><input type="hidden" name="group" value=""><input type="hidden" name="user" value=""></form>
    <dialog class="hkp-dialog is-narrow" id="hkp-group-dialog" aria-labelledby="hkp-ng-h">
        <header>{{{icons.plus}}}<h2 id="hkp-ng-h">{{#str}}groups_new, local_oksigeniahechauka{{/str}}</h2><button type="button" class="btn btn-icon" data-hkp-close aria-label="{{#str}}closebuttontitle{{/str}}">{{{icons.x}}}</button></header>
        <form class="hkp-dialog-body" id="hkp-ng-form" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="addgroup">
            <div class="hkp-field"><label class="form-label" for="hkp-ng">{{#str}}name, local_oksigeniahechauka{{/str}}</label><input class="form-control" id="hkp-ng" name="name" placeholder="{{#str}}groups_new_example, local_oksigeniahechauka{{/str}}" autocomplete="off" required></div>
            <p class="hkp-hint">{{#str}}groups_new_help, local_oksigeniahechauka{{/str}}</p>
        </form>
        <footer><button type="button" class="btn btn-outline-secondary" data-hkp-close>{{#str}}cancel{{/str}}</button><button type="submit" class="btn btn-primary" form="hkp-ng-form">{{#str}}groups_create, local_oksigeniahechauka{{/str}}</button></footer>
    </dialog>
    <dialog class="hkp-dialog is-narrow" id="hkp-new-dialog" aria-labelledby="hkp-ns-h">
        <header>{{{icons.qr}}}<h2 id="hkp-ns-h">{{#str}}addscreen_card, local_oksigeniahechauka{{/str}}</h2><button type="button" class="btn btn-icon" data-hkp-close aria-label="{{#str}}closebuttontitle{{/str}}">{{{icons.x}}}</button></header>
        <div class="hkp-dialog-body">
            <p class="hkp-block"><b>{{#str}}addscreen_step1, local_oksigeniahechauka{{/str}}</b> {{#str}}addscreen_step1_help, local_oksigeniahechauka{{/str}}</p>
            <div class="hkp-find hkp-block"><input class="form-control is-big hkp-mono" id="hkp-player-url" value="{{player}}" readonly aria-label="{{#str}}addscreen_address, local_oksigeniahechauka{{/str}}"><button type="button" class="btn btn-outline-secondary" data-copy="hkp-player-url">{{{icons.copy}}}{{#str}}addscreen_copy, local_oksigeniahechauka{{/str}}</button></div>
            <p class="hkp-block"><b>{{#str}}addscreen_step2, local_oksigeniahechauka{{/str}}</b> {{#str}}addscreen_step2_help, local_oksigeniahechauka{{/str}}</p>
            <form method="get" action="{{claim}}" class="hkp-find"><input class="form-control is-big hkp-code" name="code" placeholder="KM7 Q4X" aria-label="{{#str}}addscreen_code, local_oksigeniahechauka{{/str}}" spellcheck="false" autocomplete="off" required><button type="submit" class="btn btn-primary">{{#str}}addscreen_go, local_oksigeniahechauka{{/str}}</button></form>
            {{#admin}}<p class="hkp-hint hkp-block"><a href="{{admin}}">{{#str}}centre_admin, local_oksigeniahechauka{{/str}}</a></p>{{/admin}}
        </div>
    </dialog>
</div>
{{#js}}
(function() {
    var page = document.getElementById('hkp-groups-page');
    if (!page) {
        return;
    }
    var words = JSON.parse(page.getAttribute('data-strings') || '{}');
    var people = page.getAttribute('data-people');
    var sesskey = page.getAttribute('data-sesskey');
    var form = page.querySelector('#hkp-people-form');
    // Each list of people, with its actions: a group, those who publish everywhere, those who run the screens.
    var actions = {
        group: ['addeditor', 'removeeditor'],
        everywhere: ['addeverywhere', 'removeeverywhere'],
        managers: ['addmanager', 'removemanager']
    };
    var send = function(action, group, user) {
        form.querySelector('[name="action"]').value = action;
        form.querySelector('[name="group"]').value = group;
        form.querySelector('[name="user"]').value = user;
        form.submit();
    };
    // The dialogs (adding a screen, a new group): each opens from its buttons and closes from its own.
    page.querySelectorAll('[data-hkp-open]').forEach(function(b) {
        b.addEventListener('click', function() {
            var d = document.getElementById(b.getAttribute('data-hkp-open'));
            d.showModal();
            var first = d.querySelector('input:not([type="hidden"]):not([readonly])');
            if (first) {
                first.focus();
            }
        });
    });
    page.querySelectorAll('dialog [data-hkp-close]').forEach(function(b) {
        b.addEventListener('click', function() {
            b.closest('dialog').close();
        });
    });
    var dialog = page.querySelector('#hkp-new-dialog');
    if (location.hash === '#add') {
        dialog.showModal();
    }
    dialog.querySelectorAll('[data-copy]').forEach(function(b) {
        b.addEventListener('click', function() {
            var field = document.getElementById(b.getAttribute('data-copy'));
            field.select();
            if (navigator.clipboard) {
                navigator.clipboard.writeText(field.value);
            }
        });
    });
    // Who publishes: removing, and the search to add someone of the school.
    page.querySelectorAll('[data-remove-user]').forEach(function(b) {
        b.addEventListener('click', function(e) {
            e.preventDefault();
            var card = b.closest('[data-list]');
            send(actions[card.getAttribute('data-list')][1], card.getAttribute('data-group'), b.getAttribute('data-remove-user'));
        });
    });
    page.querySelectorAll('.hkp-search[data-list]').forEach(function(box) {
        var group = box.getAttribute('data-group');
        var kind = box.getAttribute('data-list');
        var input = box.querySelector('input');
        var list = box.querySelector('.hkp-listbox');
        var timer = null;
        var options = [];
        var current = -1;
        var close = function() {
            list.hidden = true;
            input.setAttribute('aria-expanded', 'false');
            input.removeAttribute('aria-activedescendant');
            current = -1;
        };
        var mark = function(k) {
            options.forEach(function(o, i) {
                o.setAttribute('aria-selected', i === k ? 'true' : 'false');
            });
            current = k;
            if (options[k]) {
                input.setAttribute('aria-activedescendant', options[k].id);
            }
        };
        var choose = function(o) {
            if (o && o.getAttribute('aria-disabled') !== 'true') {
                send(actions[kind][0], group, o.getAttribute('data-user'));
            }
        };
        var show = function(found) {
            list.textContent = '';
            options = [];
            var typed = input.value.trim().toLowerCase();
            found.forEach(function(p, i) {
                var li = document.createElement('li');
                li.id = 'hkp-opt-' + kind + group + '-' + i;
                li.setAttribute('role', 'option');
                li.setAttribute('data-user', p.id);
                li.setAttribute('aria-selected', 'false');
                if (p.already) {
                    li.setAttribute('aria-disabled', 'true');
                }
                var av = document.createElement('span');
                av.className = 'hkp-av';
                av.setAttribute('aria-hidden', 'true');
                av.textContent = p.initials;
                var text = document.createElement('span');
                var at = p.name.toLowerCase().indexOf(typed);
                if (at >= 0 && typed) {
                    text.appendChild(document.createTextNode(p.name.slice(0, at)));
                    var m = document.createElement('mark');
                    m.textContent = p.name.slice(at, at + typed.length);
                    text.appendChild(m);
                    text.appendChild(document.createTextNode(p.name.slice(at + typed.length)));
                } else {
                    text.textContent = p.name;
                }
                var small = document.createElement('small');
                small.textContent = p.already ? (words[kind] || words.already) : p.detail;
                text.appendChild(small);
                li.appendChild(av);
                li.appendChild(text);
                li.addEventListener('mousedown', function(e) {
                    e.preventDefault();
                    choose(li);
                });
                list.appendChild(li);
                options.push(li);
            });
            if (!found.length) {
                var none = document.createElement('li');
                none.setAttribute('aria-disabled', 'true');
                none.textContent = words.none;
                list.appendChild(none);
            }
            list.hidden = false;
            input.setAttribute('aria-expanded', 'true');
        };
        input.addEventListener('input', function() {
            clearTimeout(timer);
            if (input.value.trim().length < 2) {
                close();
                return;
            }
            timer = setTimeout(function() {
                fetch(people + '?q=' + encodeURIComponent(input.value.trim()) + '&group=' + group + '&list=' + kind +
                    '&sesskey=' + sesskey,
                    {credentials: 'same-origin'}).then(function(r) {
                    return r.json();
                }).then(show).catch(close);
            }, 250);
        });
        input.addEventListener('keydown', function(e) {
            if (list.hidden) {
                return;
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                mark(Math.min(options.length - 1, current + 1));
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                mark(Math.max(0, current - 1));
            } else if (e.key === 'Enter') {
                e.preventDefault();
                choose(options[current]);
            } else if (e.key === 'Escape') {
                close();
            }
        });
        input.addEventListener('blur', function() {
            setTimeout(close, 150);
        });
    });
})();
{{/js}}
