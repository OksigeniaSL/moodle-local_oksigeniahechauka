{{!
    @template local_oksigeniahechauka/centre_reception_moment

    One moment of «Un día aquí» (centre_reception), as the screen shows it: its picture, its hour and title over it, and
    its words; written on it. panel/recepcion.js draws the same when the block comes back from reception.php.

    Example context (json):
    {"n": 1, "time": "08:45", "title": "Entramos", "words": "Cada mañana, alguien riega el huerto.", "picture": "",
        "titlemost": 40, "saysmost": 140}
}}
<li class="hkp-rc-momento{{#picture}} has-picture{{/picture}}" data-rc-moment="{{n}}">
    <label class="hkp-rc-foto">{{#picture}}<img src="{{picture}}" alt="">{{/picture}}<span class="hkp-rc-foto-poner">{{#picture}}{{#str}}reception_day_photo_change, local_oksigeniahechauka{{/str}}{{/picture}}{{^picture}}{{#str}}reception_day_photo, local_oksigeniahechauka{{/str}}{{/picture}}</span><input class="visually-hidden sr-only" type="file" accept=".jpg,.jpeg,.png,.webp" data-rc-day-photo></label>
    <span class="hkp-rc-momento-pie">
        <input class="hkp-rc-hora" type="text" inputmode="numeric" maxlength="5" value="{{time}}" placeholder="08:45" aria-label="{{#str}}reception_day_time, local_oksigeniahechauka{{/str}}" data-rc-day-field="time" autocomplete="off">
        <input class="hkp-rc-titulo" type="text" value="{{title}}" maxlength="{{titlemost}}" placeholder="{{#str}}reception_day_title, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}reception_day_title, local_oksigeniahechauka{{/str}}" data-rc-day-field="title" autocomplete="off">
    </span>
    <textarea class="hkp-rc-frase" rows="2" maxlength="{{saysmost}}" placeholder="{{#str}}reception_day_words, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}reception_day_words, local_oksigeniahechauka{{/str}}" data-rc-day-field="words">{{words}}</textarea>
    <span class="hkp-rc-momento-mandos"><button type="button" class="btn btn-sm btn-outline-secondary" data-rc-day-move="-1" aria-label="{{#str}}reception_day_before, local_oksigeniahechauka{{/str}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.5 5.5L8 12l6.5 6.5"/></svg></button><button type="button" class="btn btn-sm btn-outline-secondary" data-rc-day-move="1" aria-label="{{#str}}reception_day_after, local_oksigeniahechauka{{/str}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.5 5.5L16 12l-6.5 6.5"/></svg></button><button type="button" class="btn btn-sm btn-outline-danger" data-rc-day-drop>{{#str}}reception_day_drop, local_oksigeniahechauka{{/str}}</button></span>
    <span class="hkp-rc-estado" aria-live="polite"></span>
</li>
