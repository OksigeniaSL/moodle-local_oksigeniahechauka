{{!
    @template local_oksigeniahechauka/panel_head

    The head of a page of the panel that is not the home: its title, its main actions and the tabs of the panel.

    Example context (json):
    {
        "style": "",
        "title": "Pantallas",
        "sub": "",
        "hasactions": false,
        "actions": [],
        "hastabs": true,
        "tabs": [{"url": "https://example.com/local/oksigeniahechauka/index.php", "label": "Lo que sale", "icon": "", "current": false},
            {"url": "https://example.com/local/oksigeniahechauka/screens.php", "label": "Pantallas y grupos", "icon": "", "current": true}]
    }
}}
<div class="hkp"{{#style}} style="{{style}}"{{/style}}>
    <header class="hkp-head">
        <div class="hkp-head-title">
            <h1>{{title}}</h1>
            {{#sub}}<p class="hkp-head-sub">{{sub}}</p>{{/sub}}
        </div>
        {{#hasactions}}
        <div class="hkp-head-actions">
            {{#actions}}<a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-secondary{{/primary}}" href="{{url}}">{{{icon}}}{{label}}</a>{{/actions}}
        </div>
        {{/hasactions}}
    </header>
    {{#hastabs}}
    <nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">
        {{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}
    </nav>
    {{/hastabs}}
</div>
