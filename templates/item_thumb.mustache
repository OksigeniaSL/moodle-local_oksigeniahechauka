{{!
    @template local_oksigeniahechauka/item_thumb

    The thumb of a piece of content, drawn as the screens draw it: the photo, a video with its length, a notice with
    its stripe, an event with its day in its stage colour, the ticker band, a month of an agenda.

    Example context (json):
    {
        "type": "event",
        "isevent": true,
        "day": "vie",
        "num": "6",
        "stage": 2
    }
}}
{{#ismedia}}<span class="hkp-thumb{{#vertical}} is-v{{/vertical}}" data-type="media">{{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}{{#video}}<span class="hkp-play"><svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 1l7 4-7 4z"/></svg>{{video}}</span>{{/video}}</span>{{/ismedia}}
{{#isnotice}}<span class="hkp-thumb{{#important}} is-important{{/important}}" data-type="notice" aria-hidden="true"><i></i><i></i></span>{{/isnotice}}
{{#isevent}}<span class="hkp-thumb" data-type="event" data-stage="{{stage}}" aria-hidden="true"><b>{{day}}<br>{{num}}</b><i></i><i></i></span>{{/isevent}}
{{#isticker}}<span class="hkp-thumb" data-type="ticker" aria-hidden="true"><span><i></i><i></i></span></span>{{/isticker}}
{{#isagenda}}<span class="hkp-thumb" data-type="agenda" aria-hidden="true">{{#agenda}}<u class="{{stage}}"></u>{{/agenda}}</span>{{/isagenda}}
