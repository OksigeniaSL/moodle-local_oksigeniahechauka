{{!
    @template local_oksigeniahechauka/demo

    The public demonstration screen: a page of its own, with the screen in the frame of a television.

    Example context (json):
    {
        "lang": "es", "title": "Pantalla de demostración", "centre": "Centro de ejemplo", "frame": "#", "width": 1920,
        "height": 1080, "vertical": false, "other": "#", "css": "#", "js": "#"
    }
}}
<!doctype html>
<html lang="{{lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{title}} · {{centre}}</title>
<link rel="stylesheet" href="{{css}}">
</head>
<body>
<main class="hkd">
    <header class="hkd-head">
        <p class="hkd-centre">{{centre}}</p>
        <h1>{{title}}</h1>
        <p>{{#str}}demo_help, local_oksigeniahechauka{{/str}}</p>
    </header>
    <div class="hkd-tv{{#vertical}} is-vertical{{/vertical}}" data-width="{{width}}" data-height="{{height}}">
        <div class="hkd-glass"><iframe src="{{frame}}" title="{{title}}" width="{{width}}" height="{{height}}"></iframe></div>
    </div>
    <nav class="hkd-actions">
        <a class="hkd-button" href="{{other}}">{{#vertical}}{{#str}}preview_horizontal, local_oksigeniahechauka{{/str}}{{/vertical}}{{^vertical}}{{#str}}preview_vertical, local_oksigeniahechauka{{/str}}{{/vertical}}</a>
        <a class="hkd-button" href="{{frame}}" target="_blank" rel="noopener">{{#str}}demo_full, local_oksigeniahechauka{{/str}}</a>
    </nav>
</main>
<script src="{{js}}"></script>
</body>
</html>
