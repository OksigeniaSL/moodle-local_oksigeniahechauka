{{!
    @template local_oksigeniahechauka/centre

    «Tu centro»: where the school is (a search, the places found, and a card with a small map drawn by the plugin,
    the coordinates and the weather there now), its colours (each with the text that goes on it) and its two logos,
    with the screen beside them, live (panel/centre.js).

    Example context (json):
    {
        "style": "", "title": "Pantallas", "hastabs": false, "tabs": [],
        "action": "https://example.com/local/oksigeniahechauka/centre.php", "sesskey": "abc",
        "query": "", "searched": false, "results": [], "hasresults": false, "resultsjson": "[]", "place": null,
        "tiles": [{"setting": "colourprimary", "value": "#1f5f8b", "name": "Principal", "use": "la cinta", "hex": "#1F5F8B", "on": "letra blanca"}],
        "defaults": true, "categories": [], "hascategories": false, "canadd": true, "canimport": false, "palette": "[]", "max": 6,
        "skins": [{"id": "petroleo", "skin": "petroleo", "name": "Petróleo", "family": "Gabarito", "checked": true, "fondo": "#f4f1ea", "texto": "#14211f", "primary": "#0e4f5c", "accent": "#ff8a3d", "skinprimary": "#0e4f5c", "skinaccent": "#ff8a3d", "tones": "[]", "stack": "Gabarito", "lettername": "Gabarito"}], "skinletters": "",
        "birthdays": {"on": false, "url": "#"},
        "custom": {"open": false, "tints": "[]", "texts": "[]", "letterskin": true, "lettercategories": [{"name": "De palo", "letters": [{"id": "gabarito", "name": "Gabarito", "stack": "Gabarito", "checked": false}]}], "groundskin": true, "groundtint": false, "grounds": [{"id": "papel", "name": "Papel", "swatch": "#f4f1ea", "surface": "#ffffff", "tones": "[]", "checked": false}], "corners": [{"id": "round", "value": "1", "name": "Redondas", "checked": true}]}, "logos": [{"area": "logo", "dark": false, "label": "Para fondo claro", "url": "", "alt": "Logotipo"}], "dayend": "16:00", "meals": {"from": "11:00", "to": "14:00"}, "videosperday": 2, "videosmost": 20, "phrase": {"value": "Aprender juntos, crecer juntos", "max": 90, "upright": 30, "uprightscreens": true, "left": "Quedan {$a} caracteres", "leftone": "Queda 1 carácter"},
        "surprises": {"on": false, "every": [{"value": 20, "label": "Cada 20 minutos", "checked": true}], "who": [{"id": "gusanito", "name": "Gusanito", "help": "Avanza, se para y se va", "picture": "https://example.com/retrato.webp", "atlas": "https://example.com/atlas.json", "checked": true, "see": "Verlo"}], "seasonal": [{"id": "nieve", "name": "Nieve", "help": "Una nevada", "picture": "https://example.com/retrato.webp", "atlas": "https://example.com/atlas.json", "checked": false, "see": "Verlo", "from": {"days": [{"value": 15, "selected": true}], "months": [{"value": 12, "label": "diciembre", "selected": true}]}, "until": {"days": [{"value": 6, "selected": true}], "months": [{"value": 1, "label": "enero", "selected": true}]} }], "weather": [{"id": "lluvia", "name": "Lluvia", "help": "Cuando llueve", "picture": "https://example.com/retrato.webp", "atlas": "https://example.com/atlas.json", "checked": false, "see": "Verlo"}], "noplace": false},
        "frame": "https://example.com/local/oksigeniahechauka/preview.php?frame=1", "placename": "", "admin": "",
        "icons": {"search": "", "pin": "", "out": "", "check": "", "link": "", "x": "", "plus": ""}, "strings": "{}"
    }
}}
<div class="hkp" id="hkp-centre-page"{{#style}} style="{{style}}"{{/style}} data-strings="{{strings}}">
    <header class="hkp-head"><div class="hkp-head-title"><h1>{{title}}</h1>{{#howto}}{{> local_oksigeniahechauka/howto_button }}{{/howto}}</div></header>
    {{#hastabs}}<nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">{{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}</nav>{{/hastabs}}
    <div class="hkp-centre">
        <div class="hkp-centre-form">
            <section class="hkp-fs" aria-labelledby="hkp-loc-h">
                <h2 id="hkp-loc-h" class="hkp-label hkp-section-label">{{#str}}centre_where, local_oksigeniahechauka{{/str}}</h2>
                <p class="hkp-hint hkp-section-hint">{{#str}}centre_where_help, local_oksigeniahechauka{{/str}}</p>
                {{> local_oksigeniahechauka/place_finder }}
            </section>
            <form method="post" action="{{action}}" enctype="multipart/form-data" id="hkp-centre-form" class="hkp-centre-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <section class="hkp-fs" aria-labelledby="hkp-logo-h">
                    <h2 id="hkp-logo-h" class="hkp-label hkp-section-label">{{#str}}centre_logo, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_logo_help, local_oksigeniahechauka{{/str}}{{#sitelogo}} <b>{{#str}}centre_logo_site, local_oksigeniahechauka{{/str}}</b>{{/sitelogo}}</p>
                    <div class="hkp-logos">{{#logos}}<div class="hkp-logo"><span class="hkp-logo-art{{#dark}} is-dark{{/dark}}">{{#url}}<img src="{{url}}" alt="{{alt}}">{{/url}}</span><b>{{label}}</b><label class="btn btn-sm btn-outline-secondary">{{#str}}compose_change, local_oksigeniahechauka{{/str}}<input class="visually-hidden sr-only" type="file" name="{{area}}" accept=".svg,.png,.jpg,.jpeg,.webp" data-logo="{{area}}"></label></div>{{/logos}}</div>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-skin-h">
                    <h2 id="hkp-skin-h" class="hkp-label hkp-section-label">{{#str}}centre_skin, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_skin_help, local_oksigeniahechauka{{/str}}</p>
                    <div class="hkp-skins" role="radiogroup" aria-labelledby="hkp-skin-h" data-letters="{{skinletters}}">{{#skins}}<label class="hkp-skin"><input class="visually-hidden sr-only" type="radio" name="skin" value="{{id}}" data-skin="{{skin}}" data-primary="{{primary}}" data-accent="{{accent}}" data-skin-primary="{{skinprimary}}" data-skin-accent="{{skinaccent}}" data-tones="{{tones}}" data-stack="{{stack}}" data-letter-name="{{lettername}}"{{#checked}} checked{{/checked}}><span class="hkp-skin-art" style="background:{{fondo}};color:{{texto}};font-family:'{{family}}',sans-serif" aria-hidden="true"><b>Aa</b><i style="background:{{primary}}"><u style="background:{{accent}}"></u></i></span><span class="hkp-skin-name">{{name}}</span></label>{{/skins}}</div>
                    <div class="hkp-custom-bar"><button type="button" class="btn btn-outline-secondary hkp-custom-toggle" id="hkp-custom-open" aria-controls="hkp-custom" aria-expanded="{{#custom.open}}true{{/custom.open}}{{^custom.open}}false{{/custom.open}}">{{#str}}centre_custom, local_oksigeniahechauka{{/str}}</button><span class="hkp-hint" id="hkp-custom-note"{{^custom.open}} hidden{{/custom.open}}>{{#str}}centre_custom_changed, local_oksigeniahechauka{{/str}}</span></div>
                    <div class="hkp-custom" id="hkp-custom" data-tints="{{custom.tints}}" data-texts="{{custom.texts}}"{{^custom.open}} hidden{{/custom.open}}>
                        <p class="hkp-hint">{{#str}}centre_custom_help, local_oksigeniahechauka{{/str}}</p>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-col-h">{{#str}}centre_colours, local_oksigeniahechauka{{/str}}</span>
                            <p class="hkp-hint">{{#str}}centre_colours_help, local_oksigeniahechauka{{/str}}{{#defaults}} <b>{{#str}}centre_colours_defaults, local_oksigeniahechauka{{/str}}</b>{{/defaults}}</p>
                            <div class="hkp-colours">{{#tiles}}<label class="hkp-colour"><input type="color" name="{{setting}}" value="{{value}}" data-colour="{{setting}}" aria-describedby="hkp-c-{{setting}}"><b>{{name}}</b><span id="hkp-c-{{setting}}">{{use}} · <span data-hex="{{setting}}">{{hex}}</span>, <span data-on="{{setting}}">{{on}}</span></span></label>{{/tiles}}</div>
                        </div>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-gr-h">{{#str}}centre_custom_ground, local_oksigeniahechauka{{/str}}</span>
                            <p class="hkp-hint">{{#str}}centre_custom_ground_help, local_oksigeniahechauka{{/str}}</p>
                            <div class="hkp-grounds" role="radiogroup" aria-labelledby="hkp-gr-h"><label class="hkp-ground"><input class="visually-hidden sr-only" type="radio" name="skinground" value=""{{#custom.groundskin}} checked{{/custom.groundskin}}><span class="hkp-tile"><span class="hkp-ground-art" data-ground-skin aria-hidden="true"><i><u></u></i></span><span class="hkp-tile-name">{{#str}}centre_custom_ground_skin, local_oksigeniahechauka{{/str}}</span></span></label><label class="hkp-ground"><input class="visually-hidden sr-only" type="radio" name="skinground" value="tint"{{#custom.groundtint}} checked{{/custom.groundtint}}><span class="hkp-tile"><span class="hkp-ground-art" data-ground-tint aria-hidden="true"><i><u></u></i></span><span class="hkp-tile-name">{{#str}}centre_custom_ground_tint, local_oksigeniahechauka{{/str}}</span></span></label>{{#custom.grounds}}<label class="hkp-ground"><input class="visually-hidden sr-only" type="radio" name="skinground" value="{{id}}" data-tones="{{tones}}"{{#checked}} checked{{/checked}}><span class="hkp-tile"><span class="hkp-ground-art" style="--hkp-g-fondo:{{swatch}};--hkp-g-sup:{{surface}}" aria-hidden="true"><i><u></u></i></span><span class="hkp-tile-name">{{name}}</span></span></label>{{/custom.grounds}}</div>
                        </div>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-le-h">{{#str}}centre_custom_letter, local_oksigeniahechauka{{/str}}</span>
                            <p class="hkp-hint">{{#str}}centre_custom_letter_help, local_oksigeniahechauka{{/str}}</p>
                            <div class="hkp-letters" role="radiogroup" aria-labelledby="hkp-le-h"><label class="hkp-letter"><input class="visually-hidden sr-only" type="radio" name="skinletter" value=""{{#custom.letterskin}} checked{{/custom.letterskin}}><span class="hkp-tile"><span class="hkp-letter-art" data-letter-skin aria-hidden="true">Aa 10:45</span><span class="hkp-tile-name">{{#str}}centre_custom_letter_skin, local_oksigeniahechauka{{/str}}: <span data-letter-skin-name></span></span></span></label>{{#custom.lettercategories}}<span class="hkp-letter-cat">{{name}}</span>{{#letters}}<label class="hkp-letter"><input class="visually-hidden sr-only" type="radio" name="skinletter" value="{{id}}" data-stack="{{stack}}"{{#checked}} checked{{/checked}}><span class="hkp-tile"><span class="hkp-letter-art" style="font-family:{{stack}}" aria-hidden="true">Aa 10:45</span><span class="hkp-tile-name">{{name}}</span></span></label>{{/letters}}{{/custom.lettercategories}}</div>
                        </div>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-co-h">{{#str}}centre_custom_corners, local_oksigeniahechauka{{/str}}</span>
                            <div class="hkp-chips" role="radiogroup" aria-labelledby="hkp-co-h">{{#custom.corners}}<label class="hkp-chip is-small"><input type="radio" name="skincorners" value="{{id}}" data-corner="{{value}}"{{#checked}} checked{{/checked}}>{{name}}</label>{{/custom.corners}}</div>
                        </div>
                        <div><button type="button" class="btn btn-outline-secondary btn-sm" id="hkp-custom-reset">{{#str}}centre_custom_reset, local_oksigeniahechauka{{/str}}</button></div>
                    </div>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-cat-h">
                    <h2 id="hkp-cat-h" class="hkp-label hkp-section-label">{{#str}}centre_categories, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_categories_help, local_oksigeniahechauka{{/str}}</p>
                    <ol class="hkp-cats" id="hkp-cats" data-palette="{{palette}}" data-max="{{max}}">
                        {{#categories}}<li class="hkp-cat"{{#linked}} data-linked="1"{{/linked}}><input type="hidden" name="cat_id[]" value="{{id}}"><input type="hidden" name="cat_coursecat[]" value="{{coursecat}}" data-coursecat><input type="hidden" name="cat_words[]" value="{{words}}" data-words>
                            <label class="hkp-cat-swatch" title="{{#str}}centre_category_colour, local_oksigeniahechauka, {{name}}{{/str}}"><input type="color" name="cat_colour[]" value="{{colour}}" data-category aria-label="{{#str}}centre_category_colour, local_oksigeniahechauka, {{name}}{{/str}}"></label>
                            <div class="hkp-cat-main">
                                <div class="hkp-cat-line"><input class="hkp-cat-name" name="cat_name[]" value="{{name}}" maxlength="60" autocomplete="off" aria-label="{{#str}}centre_category_name, local_oksigeniahechauka{{/str}}">{{#linked}}<span class="hkp-cat-link" title="{{linked}}">{{{icons.link}}}<span class="visually-hidden sr-only">{{linked}}</span></span>{{/linked}}</div>
                                <div class="hkp-cat-words" aria-label="{{#str}}centre_category_words, local_oksigeniahechauka{{/str}}" role="group">{{#wordlist}}<span class="hkp-word">{{word}}<button type="button" data-word-remove aria-label="{{remove}}">{{{icons.x}}}</button></span>{{/wordlist}}<button type="button" class="hkp-word-add" data-word-add title="{{#str}}centre_word_hint, local_oksigeniahechauka{{/str}}">{{{icons.plus}}}{{#str}}centre_word_add, local_oksigeniahechauka{{/str}}</button></div>
                                <small class="hkp-cat-count">{{count}}</small>
                            </div>
                            {{#linked}}<button type="button" class="btn btn-sm btn-outline-secondary" data-unlink-cat title="{{unlink}}">{{#str}}centre_category_unlink_short, local_oksigeniahechauka{{/str}}<span class="visually-hidden sr-only"> {{name}}</span></button>{{/linked}}
                            {{^linked}}<button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-remove-cat aria-label="{{remove}}" title="{{remove}}">{{{icons.x}}}</button>{{/linked}}
                        </li>{{/categories}}
                    </ol>
                    {{^hascategories}}<p class="hkp-hint" id="hkp-cats-none">{{#str}}centre_categories_none, local_oksigeniahechauka{{/str}}</p>{{/hascategories}}
                    <template id="hkp-cat-new"><li class="hkp-cat"><input type="hidden" name="cat_id[]" value=""><input type="hidden" name="cat_coursecat[]" value="0" data-coursecat><input type="hidden" name="cat_words[]" value="" data-words><label class="hkp-cat-swatch"><input type="color" name="cat_colour[]" value="#1f5f8b" data-category aria-label="{{#str}}centre_category_colour_new, local_oksigeniahechauka{{/str}}"></label><div class="hkp-cat-main"><div class="hkp-cat-line"><input class="hkp-cat-name" name="cat_name[]" maxlength="60" autocomplete="off" placeholder="{{#str}}centre_category_new_name, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}centre_category_name, local_oksigeniahechauka{{/str}}"></div><div class="hkp-cat-words" role="group" aria-label="{{#str}}centre_category_words, local_oksigeniahechauka{{/str}}"><button type="button" class="hkp-word-add" data-word-add title="{{#str}}centre_word_hint, local_oksigeniahechauka{{/str}}">{{{icons.plus}}}{{#str}}centre_word_add, local_oksigeniahechauka{{/str}}</button></div></div><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-remove-cat aria-label="{{#str}}centre_category_remove_new, local_oksigeniahechauka{{/str}}">{{{icons.x}}}</button></li></template>
                    <div class="hkp-chips">{{#canadd}}<button type="button" class="btn btn-outline-secondary" id="hkp-cat-add">+ {{#str}}centre_category_add, local_oksigeniahechauka{{/str}}</button>{{/canadd}}{{#canimport}}<button type="submit" class="btn btn-outline-secondary" name="import" value="1">{{#str}}centre_category_import, local_oksigeniahechauka{{/str}}</button>{{/canimport}}</div>
                    <p class="hkp-hint">{{#str}}centre_category_words_help, local_oksigeniahechauka{{/str}}</p>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-bd-h">
                    <h2 id="hkp-bd-h" class="hkp-label hkp-section-label">{{#str}}birthdays_title, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#birthdays.on}}{{#str}}centre_birthdays_on, local_oksigeniahechauka{{/str}}{{/birthdays.on}}{{^birthdays.on}}{{#str}}centre_birthdays_off, local_oksigeniahechauka{{/str}}{{/birthdays.on}}</p>
                    <a class="btn btn-outline-secondary" href="{{birthdays.url}}">{{#str}}centre_birthdays_open, local_oksigeniahechauka{{/str}}</a>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-day-h">
                    <h2 id="hkp-day-h" class="hkp-label hkp-section-label">{{#str}}centre_day, local_oksigeniahechauka{{/str}}</h2>
                    <div class="hkp-day"><label class="form-label" for="hkp-dayend">{{#str}}centre_dayend, local_oksigeniahechauka{{/str}}</label><input type="time" class="form-control" id="hkp-dayend" name="dayend" value="{{dayend}}" required></div>
                    <p class="hkp-hint">{{#str}}centre_dayend_help, local_oksigeniahechauka{{/str}}</p>
                    {{#meals}}
                    <div class="hkp-day"><label class="form-label" for="hkp-mealfrom">{{#str}}centre_meals, local_oksigeniahechauka{{/str}}</label><input type="time" class="form-control" id="hkp-mealfrom" name="mealfrom" value="{{from}}" required><label class="form-label" for="hkp-mealto">{{#str}}centre_meals_to, local_oksigeniahechauka{{/str}}</label><input type="time" class="form-control" id="hkp-mealto" name="mealto" value="{{to}}" required></div>
                    <p class="hkp-hint">{{#str}}centre_meals_help, local_oksigeniahechauka{{/str}}</p>
                    {{/meals}}
                    <div class="hkp-day"><label class="form-label" for="hkp-videos">{{#str}}centre_videos, local_oksigeniahechauka{{/str}}</label><input type="number" class="form-control" id="hkp-videos" name="videosperday" value="{{videosperday}}" min="0" max="{{videosmost}}" required></div>
                    <p class="hkp-hint">{{#str}}centre_videos_help, local_oksigeniahechauka{{/str}}</p>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-phrase-h">
                    <h2 id="hkp-phrase-h" class="hkp-label hkp-section-label">{{#str}}centre_phrase, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_phrase_help, local_oksigeniahechauka{{/str}}</p>
                    <textarea class="form-control hkp-phrase hkp-phrase-cinta" id="hkp-phrase" name="centrephrase" rows="2" maxlength="{{phrase.max}}" data-upright="{{phrase.upright}}" aria-labelledby="hkp-phrase-h" aria-describedby="hkp-phrase-count" placeholder="{{#str}}centre_phrase_placeholder, local_oksigeniahechauka{{/str}}">{{phrase.value}}</textarea>
                    <p class="hkp-hint" id="hkp-phrase-count" data-left="{{phrase.left}}" data-left-one="{{phrase.leftone}}" aria-live="polite"></p>
                    {{#phrase.uprightscreens}}<p class="hkp-hint" id="hkp-phrase-upright" hidden>{{#str}}centre_phrase_upright, local_oksigeniahechauka, {{phrase.upright}}{{/str}}</p>{{/phrase.uprightscreens}}
                </section>
                <div class="hkp-foot"><button type="submit" class="btn btn-primary">{{#str}}centre_save, local_oksigeniahechauka{{/str}}</button><p class="hkp-hint">{{#str}}centre_technical, local_oksigeniahechauka{{/str}}{{#admin}} <a href="{{admin}}">{{#str}}centre_admin, local_oksigeniahechauka{{/str}}</a>{{/admin}}</p></div>
            </form>
        </div>
        <div class="hkp-centre-side">
        <aside class="hkp-preview" aria-labelledby="hkp-cpv-h">
            <div class="hkp-preview-head"><h2 id="hkp-cpv-h">{{#str}}centre_preview, local_oksigeniahechauka{{/str}}</h2><div class="hkp-seg" role="group" aria-label="{{#str}}centre_theme, local_oksigeniahechauka{{/str}}"><button type="button" aria-pressed="true" data-ct="light">{{#str}}thememode_light, local_oksigeniahechauka{{/str}}</button><button type="button" aria-pressed="false" data-ct="dark">{{#str}}thememode_dark, local_oksigeniahechauka{{/str}}</button></div></div>
            <div class="hkp-stage"><span class="hkp-bezel" data-state="on"><iframe id="hkp-cpv" src="{{frame}}" title="{{#str}}centre_preview_title, local_oksigeniahechauka{{/str}}"></iframe><span class="hkp-led" aria-hidden="true"></span></span></div>
            {{#placename}}<p class="hkp-preview-note">{{#str}}centre_preview_note, local_oksigeniahechauka, {{placename}}{{/str}}</p>{{/placename}}
        </aside>
                <section class="hkp-fs" aria-labelledby="hkp-sur-h">
                    <h2 id="hkp-sur-h" class="hkp-label hkp-section-label">{{#str}}centre_surprises, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_surprises_help, local_oksigeniahechauka{{/str}}</p>
                    <div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-surprises" name="surprises" form="hkp-centre-form" value="1"{{#surprises.on}} checked{{/surprises.on}}><div><label class="form-check-label" for="hkp-surprises"><b>{{#str}}centre_surprises_on, local_oksigeniahechauka{{/str}}</b></label><p class="hkp-hint">{{#str}}centre_surprises_on_help, local_oksigeniahechauka{{/str}}</p></div></div>
                    <div id="hkp-surprises-box"{{^surprises.on}} hidden{{/surprises.on}}>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-sur-e">{{#str}}centre_surprises_every, local_oksigeniahechauka{{/str}}</span><div class="hkp-chips" role="radiogroup" aria-labelledby="hkp-sur-e">{{#surprises.every}}<label class="hkp-chip is-small"><input type="radio" name="surpriseevery" form="hkp-centre-form" value="{{value}}"{{#checked}} checked{{/checked}}>{{label}}</label>{{/surprises.every}}</div></div>
                        <div class="hkp-field"><span class="hkp-label" id="hkp-sur-w">{{#str}}centre_surprises_who, local_oksigeniahechauka{{/str}}</span><ul class="hkp-surprises" aria-labelledby="hkp-sur-w">{{#surprises.who}}<li class="hkp-surprise"><label><input type="checkbox" name="surprisewho[]" form="hkp-centre-form" value="{{id}}"{{#checked}} checked{{/checked}}><img src="{{picture}}" alt=""><span><b>{{name}}</b><small>{{help}}</small></span></label><button type="button" class="btn btn-sm btn-outline-secondary" data-surprise-id="{{id}}" data-surprise-atlas="{{atlas}}">{{see}}</button></li>{{/surprises.who}}</ul></div>
