{{!
    @template local_oksigeniahechauka/centre

    «Tu centro»: where the school is (a search, the places found, and a card with a small map drawn by the plugin,
    the coordinates and the weather there now), its colours (each with the text that goes on it) and its two logos,
    with the screen beside them, live (panel/centre.js).

    Example context (json):
    {
        "style": "", "title": "Pantallas", "hastabs": false, "tabs": [],
        "action": "https://example.com/local/oksigeniahechauka/centre.php", "sesskey": "abc",
        "query": "", "searched": false, "results": [], "hasresults": false, "resultsjson": "[]", "place": null,
        "tiles": [{"setting": "colourprimary", "value": "#1f5f8b", "name": "Principal", "use": "la cinta", "hex": "#1F5F8B", "on": "letra blanca"}],
        "defaults": true, "categories": [], "hascategories": false, "canadd": true, "canimport": false, "palette": "[]", "max": 6,
        "logos": [{"area": "logo", "dark": false, "label": "Para fondo claro", "url": "", "alt": "Logotipo"}],
        "frame": "https://example.com/local/oksigeniahechauka/preview.php?frame=1", "placename": "", "admin": "",
        "icons": {"search": "", "pin": "", "out": "", "check": ""}, "strings": "{}"
    }
}}
<div class="hkp" id="hkp-centre-page"{{#style}} style="{{style}}"{{/style}} data-strings="{{strings}}">
    <header class="hkp-head"><div class="hkp-head-title"><h1>{{title}}</h1></div></header>
    {{#hastabs}}<nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">{{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}</nav>{{/hastabs}}
    <div class="hkp-centre">
        <div class="hkp-centre-form">
            <section class="hkp-fs" aria-labelledby="hkp-loc-h">
                <h2 id="hkp-loc-h" class="hkp-label hkp-section-label">{{#str}}centre_where, local_oksigeniahechauka{{/str}}</h2>
                <p class="hkp-hint hkp-section-hint">{{#str}}centre_where_help, local_oksigeniahechauka{{/str}}</p>
                {{#searched}}<form method="post" action="{{action}}" id="hkp-pick-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="results" value="{{resultsjson}}"></form>{{/searched}}
                <form method="get" action="{{action}}" class="hkp-find" role="search">
                    <div class="hkp-search">{{{icons.search}}}<input class="form-control is-big" id="hkp-q" name="q" value="{{query}}" aria-label="{{#str}}centre_search_label, local_oksigeniahechauka{{/str}}" autocomplete="off" spellcheck="false"{{#hasresults}} aria-controls="hkp-places" aria-expanded="true"{{/hasresults}}>
                        {{#searched}}
                        <ul class="hkp-listbox" id="hkp-places" aria-label="{{#str}}centre_found, local_oksigeniahechauka{{/str}}">
                            {{#results}}<li><button type="submit" form="hkp-pick-form" name="pick" value="{{i}}" class="hkp-pick">{{{icons.pin}}}<span>{{before}}<mark>{{mark}}</mark>{{after}}<small>{{detail}}</small></span></button></li>{{/results}}
                            <li aria-disabled="true" class="hkp-nofind"><small>{{^hasresults}}{{#str}}centre_none, local_oksigeniahechauka{{/str}} {{/hasresults}}{{#str}}centre_tip, local_oksigeniahechauka{{/str}}</small></li>
                        </ul>
                        {{/searched}}
                    </div>
                    <button type="submit" class="btn btn-outline-secondary">{{#str}}search{{/str}}</button>
                </form>
                {{#place}}
                <div class="hkp-place" aria-live="polite">
                    <span class="hkp-map"><svg viewBox="0 0 320 200" role="img" aria-label="{{#str}}centre_map, local_oksigeniahechauka, {{name}}{{/str}}"><rect class="sea" width="320" height="200"/><path class="grid" d="{{map.grid}}"/><path class="land" d="{{map.land}}"/><path class="grid-over" d="{{map.grid}}"/><circle class="ring" cx="160" cy="100" r="13"/><circle class="pin" cx="160" cy="100" r="5.5"/><path class="scale" d="M10 188h{{map.km100}}M10 185v6"/></svg><span class="hkp-map-scale">100 km</span></span>
                    <div>
                        <h3>{{name}}</h3>
                        <p class="hkp-place-where">{{where}}</p>
                        <p class="hkp-place-coords">{{coords}}</p>
                        <div class="hkp-foot"><a class="btn btn-sm btn-outline-secondary" href="{{osm}}" target="_blank" rel="noopener">{{{icons.out}}}{{#str}}centre_onmap, local_oksigeniahechauka{{/str}}<span class="visually-hidden sr-only"> {{#str}}centre_newtab, local_oksigeniahechauka{{/str}}</span></a><a class="btn btn-sm btn-outline-secondary" href="#hkp-q" data-hkp-focus="hkp-q">{{#str}}compose_change, local_oksigeniahechauka{{/str}}</a></div>
                    </div>
                    <div class="hkp-place-check">
                        {{#weather}}<div class="hkp-weather"><span class="hkp-weather-icon" aria-hidden="true" data-hk-sky="{{symbol}}"></span><span class="hkp-weather-deg">{{temp}}°</span><span class="hkp-weather-ext">{{max}}°<span>{{min}}°</span></span><span class="hkp-weather-sky">{{text}}<small>{{#str}}centre_now, local_oksigeniahechauka{{/str}}</small></span></div>{{/weather}}
                        {{^weather}}<p class="hkp-hint">{{#str}}centre_noweather, local_oksigeniahechauka{{/str}}</p>{{/weather}}
                        <p class="hkp-place-ok">{{{icons.check}}}{{#str}}centre_ok, local_oksigeniahechauka{{/str}}</p>
                    </div>
                </div>
                {{/place}}
            </section>
            <form method="post" action="{{action}}" enctype="multipart/form-data" id="hkp-centre-form" class="hkp-centre-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <section class="hkp-fs" aria-labelledby="hkp-col-h">
                    <h2 id="hkp-col-h" class="hkp-label hkp-section-label">{{#str}}centre_colours, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_colours_help, local_oksigeniahechauka{{/str}}{{#defaults}} <b>{{#str}}centre_colours_defaults, local_oksigeniahechauka{{/str}}</b>{{/defaults}}</p>
                    <div class="hkp-colours">{{#tiles}}<label class="hkp-colour"><input type="color" name="{{setting}}" value="{{value}}" data-colour="{{setting}}" aria-describedby="hkp-c-{{setting}}"><b>{{name}}</b><span id="hkp-c-{{setting}}">{{use}} · <span data-hex="{{setting}}">{{hex}}</span>, <span data-on="{{setting}}">{{on}}</span></span></label>{{/tiles}}</div>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-cat-h">
                    <h2 id="hkp-cat-h" class="hkp-label hkp-section-label">{{#str}}centre_categories, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_categories_help, local_oksigeniahechauka{{/str}}</p>
                    <ol class="hkp-cats" id="hkp-cats" data-palette="{{palette}}" data-max="{{max}}">
                        {{#categories}}<li class="hkp-cat"><input type="hidden" name="cat_id[]" value="{{id}}"><input type="hidden" name="cat_coursecat[]" value="{{coursecat}}">
                            <input type="color" name="cat_colour[]" value="{{colour}}" data-category aria-label="{{#str}}centre_category_colour, local_oksigeniahechauka, {{name}}{{/str}}">
                            <div class="hkp-field"><label class="form-label" for="hkp-cat-n{{n}}">{{#str}}name, local_oksigeniahechauka{{/str}}</label><input class="form-control" id="hkp-cat-n{{n}}" name="cat_name[]" value="{{name}}" maxlength="60" autocomplete="off"></div>
                            <div class="hkp-field hkp-cat-words"><label class="form-label" for="hkp-cat-w{{n}}">{{#str}}centre_category_words, local_oksigeniahechauka{{/str}}</label><input class="form-control" id="hkp-cat-w{{n}}" name="cat_words[]" value="{{words}}" autocomplete="off"></div>
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-remove-cat aria-label="{{remove}}" title="{{remove}}">×</button>
                            {{#linked}}<small>{{linked}}</small>{{/linked}}
                        </li>{{/categories}}
                    </ol>
                    {{^hascategories}}<p class="hkp-hint" id="hkp-cats-none">{{#str}}centre_categories_none, local_oksigeniahechauka{{/str}}</p>{{/hascategories}}
                    <template id="hkp-cat-new"><li class="hkp-cat"><input type="hidden" name="cat_id[]" value=""><input type="hidden" name="cat_coursecat[]" value="0"><input type="color" name="cat_colour[]" value="#1f5f8b" data-category aria-label="{{#str}}centre_category_colour_new, local_oksigeniahechauka{{/str}}"><div class="hkp-field"><label class="form-label">{{#str}}name, local_oksigeniahechauka{{/str}}<input class="form-control" name="cat_name[]" maxlength="60" autocomplete="off"></label></div><div class="hkp-field hkp-cat-words"><label class="form-label">{{#str}}centre_category_words, local_oksigeniahechauka{{/str}}<input class="form-control" name="cat_words[]" autocomplete="off"></label></div><button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-remove-cat aria-label="{{#str}}centre_category_remove_new, local_oksigeniahechauka{{/str}}">×</button></li></template>
                    <div class="hkp-chips">{{#canadd}}<button type="button" class="btn btn-outline-secondary" id="hkp-cat-add">+ {{#str}}centre_category_add, local_oksigeniahechauka{{/str}}</button>{{/canadd}}{{#canimport}}<button type="submit" class="btn btn-outline-secondary" name="import" value="1">{{#str}}centre_category_import, local_oksigeniahechauka{{/str}}</button>{{/canimport}}</div>
                    <p class="hkp-hint">{{#str}}centre_category_words_help, local_oksigeniahechauka{{/str}}</p>
                </section>
                <section class="hkp-fs" aria-labelledby="hkp-logo-h">
                    <h2 id="hkp-logo-h" class="hkp-label hkp-section-label">{{#str}}centre_logo, local_oksigeniahechauka{{/str}}</h2>
                    <p class="hkp-hint hkp-section-hint">{{#str}}centre_logo_help, local_oksigeniahechauka{{/str}}</p>
                    <div class="hkp-logos">{{#logos}}<div class="hkp-logo"><span class="hkp-logo-art{{#dark}} is-dark{{/dark}}">{{#url}}<img src="{{url}}" alt="{{alt}}">{{/url}}</span><b>{{label}}</b><label class="btn btn-sm btn-outline-secondary">{{#str}}compose_change, local_oksigeniahechauka{{/str}}<input class="visually-hidden sr-only" type="file" name="{{area}}" accept=".svg,.png,.jpg,.jpeg,.webp" data-logo="{{area}}"></label></div>{{/logos}}</div>
                </section>
                <div class="hkp-foot"><button type="submit" class="btn btn-primary btn-lg">{{#str}}centre_save, local_oksigeniahechauka{{/str}}</button><p class="hkp-hint">{{#str}}centre_technical, local_oksigeniahechauka{{/str}}{{#admin}} <a href="{{admin}}">{{#str}}centre_admin, local_oksigeniahechauka{{/str}}</a>{{/admin}}</p></div>
            </form>
        </div>
        <aside class="hkp-preview" aria-labelledby="hkp-cpv-h">
            <div class="hkp-preview-head"><h2 id="hkp-cpv-h">{{#str}}centre_preview, local_oksigeniahechauka{{/str}}</h2><div class="hkp-seg" role="group" aria-label="{{#str}}centre_theme, local_oksigeniahechauka{{/str}}"><button type="button" aria-pressed="true" data-ct="light">{{#str}}thememode_light, local_oksigeniahechauka{{/str}}</button><button type="button" aria-pressed="false" data-ct="dark">{{#str}}thememode_dark, local_oksigeniahechauka{{/str}}</button></div></div>
            <div class="hkp-stage"><span class="hkp-bezel" data-state="on"><iframe id="hkp-cpv" src="{{frame}}" title="{{#str}}centre_preview_title, local_oksigeniahechauka{{/str}}"></iframe><span class="hkp-led" aria-hidden="true"></span></span></div>
            {{#placename}}<p class="hkp-preview-note">{{#str}}centre_preview_note, local_oksigeniahechauka, {{placename}}{{/str}}</p>{{/placename}}
        </aside>
    </div>
</div>
