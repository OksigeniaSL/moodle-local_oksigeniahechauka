{{!
    @template local_oksigeniahechauka/birthdays

    The birthdays: whether the screens show them, the field of the profile and the list kept here. Nothing to press to
    save a switch or a choice: each one saves as it changes (the button is there only without a script). Someone new is
    written on a calendar page (the month on its band, the day big, the name and the group on its lines, a photo beside);
    many at once come in three ways side by side: a sheet, a pasted list or several photos.

    Example context (json):
    {
        "tabs": [{"url": "#", "label": "Tu centro", "icon": "", "current": true}], "hastabs": true, "centre": "#", "action": "#",
        "sesskey": "abc", "modelurl": "#", "moodlepictures": "#", "on": true, "greetcard": true, "greetnotify": false,
        "people_url": "#", "unlinked": 1, "hasunlinked": true, "linkstrings": "{}", "icons": {"x": "", "search": ""}, "fields": [{"value": "", "label": "Ninguno", "selected": true}], "hasfields": false,
        "days": [1, 2], "months": [{"value": 1, "label": "enero"}], "count": 1, "haspeople": true, "hastoday": true,
        "today": "Lucía Pérez",
        "people": [{"id": 1, "name": "Lucía Pérez", "group": "3.º A", "idnumber": "1024", "date": "15 marzo", "photo": "", "initial": "L",
            "account": "", "linked": false, "userid": 0}]
    }
}}
<div class="hkp" id="hkp-birthdays-page" data-people="{{people_url}}" data-sesskey="{{sesskey}}" data-strings="{{linkstrings}}">
    <header class="hkp-head"><div class="hkp-head-title"><h1>{{#str}}birthdays_title, local_oksigeniahechauka{{/str}}</h1>{{#howto}}{{> local_oksigeniahechauka/howto_button }}{{/howto}}</div></header>
    {{#hastabs}}<nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">{{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}</nav>{{/hastabs}}
    <div class="hkp-birthdays">
        <section class="hkp-fs" aria-labelledby="hkp-bd-on">
            <h2 id="hkp-bd-on" class="hkp-label hkp-section-label">{{#str}}birthdays_screens, local_oksigeniahechauka{{/str}}</h2>
            <p class="hkp-hint hkp-section-hint">{{#str}}birthdays_help, local_oksigeniahechauka{{/str}}</p>
            <form method="post" action="{{action}}" data-saves>
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="settings">
                <div class="form-switch form-check hkp-field"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-switch" name="on" value="1"{{#on}} checked{{/on}}><label class="form-check-label" for="hkp-bd-switch">{{#str}}birthdays_on, local_oksigeniahechauka{{/str}}</label></div>
                {{#hasfields}}<div class="hkp-field"><label class="form-label" for="hkp-bd-field">{{#str}}birthdays_field, local_oksigeniahechauka{{/str}}</label><select class="form-select" id="hkp-bd-field" name="field">{{#fields}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/fields}}</select><p class="hkp-hint">{{#str}}birthdays_field_help, local_oksigeniahechauka{{/str}}</p></div>{{/hasfields}}
                {{^hasfields}}<p class="hkp-hint">{{#str}}birthdays_field_empty, local_oksigeniahechauka{{/str}}</p>{{/hasfields}}
                {{#family}}<div class="form-switch form-check hkp-field"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-family" name="family" value="1"{{#on}} checked{{/on}}><label class="form-check-label" for="hkp-bd-family">{{#str}}birthdays_family, local_oksigeniahechauka{{/str}}</label><p class="hkp-hint">{{#str}}birthdays_family_help, local_oksigeniahechauka{{/str}}</p></div>{{/family}}
                {{#cifra}}<div class="form-switch form-check hkp-field"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-cifra" name="cifra" value="1"{{#on}} checked{{/on}}><label class="form-check-label" for="hkp-bd-cifra">{{#str}}birthdays_cifra, local_oksigeniahechauka{{/str}}</label><p class="hkp-hint">{{status}}</p></div>{{/cifra}}
                <div class="hkp-foot" data-without-script><button type="submit" class="btn btn-primary">{{#str}}centre_save, local_oksigeniahechauka{{/str}}</button></div>
                <p class="hkp-saved-note" role="status" hidden>{{#str}}birthdays_saved, local_oksigeniahechauka{{/str}}</p>
            </form>
            <p class="hkp-hint hkp-bd-today">{{#hastoday}}{{#str}}birthdays_today, local_oksigeniahechauka, {{today}}{{/str}}{{/hastoday}}{{^hastoday}}{{#str}}birthdays_today_none, local_oksigeniahechauka{{/str}}{{/hastoday}}</p>
        </section>
        <section class="hkp-fs" aria-labelledby="hkp-bd-moodle">
            <h2 id="hkp-bd-moodle" class="hkp-label hkp-section-label">{{#str}}birthdays_moodle, local_oksigeniahechauka{{/str}}</h2>
            <p class="hkp-hint hkp-section-hint">{{#str}}birthdays_moodle_help, local_oksigeniahechauka{{/str}}</p>
            <form method="post" action="{{action}}" data-saves>
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="greeting">
                <div class="form-switch form-check hkp-field"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-greetcard" name="card" value="1"{{#greetcard}} checked{{/greetcard}}><label class="form-check-label" for="hkp-bd-greetcard">{{#str}}birthdays_greetcard, local_oksigeniahechauka{{/str}}</label><p class="hkp-hint">{{#str}}birthdays_greetcard_help, local_oksigeniahechauka{{/str}}</p></div>
                <div class="form-switch form-check hkp-field"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-greetnotify" name="notify" value="1"{{#greetnotify}} checked{{/greetnotify}}><label class="form-check-label" for="hkp-bd-greetnotify">{{#str}}birthdays_greetnotify, local_oksigeniahechauka{{/str}}</label><p class="hkp-hint">{{#str}}birthdays_greetnotify_help, local_oksigeniahechauka{{/str}}</p></div>
                <div class="hkp-foot" data-without-script><button type="submit" class="btn btn-primary">{{#str}}centre_save, local_oksigeniahechauka{{/str}}</button></div>
                <p class="hkp-saved-note" role="status" hidden>{{#str}}birthdays_saved, local_oksigeniahechauka{{/str}}</p>
            </form>
        </section>
        <section class="hkp-fs" aria-labelledby="hkp-bd-add">
            <h2 id="hkp-bd-add" class="hkp-label hkp-section-label">{{#str}}birthdays_add, local_oksigeniahechauka{{/str}}</h2>
            <p class="hkp-hint hkp-section-hint">{{#str}}birthdays_add_help, local_oksigeniahechauka{{/str}}</p>
            <form method="post" action="{{action}}" enctype="multipart/form-data" class="hkp-bd-new">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="add">
                <div class="hkp-bd-cal">
                    <label class="visually-hidden sr-only" for="hkp-bd-month">{{#str}}birthdays_month, local_oksigeniahechauka{{/str}}</label><select class="hkp-bd-cal-month" id="hkp-bd-month" name="month">{{#months}}<option value="{{value}}">{{label}}</option>{{/months}}</select>
                    <label class="visually-hidden sr-only" for="hkp-bd-day">{{#str}}birthdays_day, local_oksigeniahechauka{{/str}}</label><select class="hkp-bd-cal-day" id="hkp-bd-day" name="day">{{#days}}<option value="{{.}}">{{.}}</option>{{/days}}</select>
                </div>
                <div class="hkp-bd-person">
                    <label class="hkp-bd-line is-name"><span>{{#str}}birthdays_name, local_oksigeniahechauka{{/str}}</span><input id="hkp-bd-name" name="name" maxlength="120" required autocomplete="off"></label>
                    <div class="hkp-bd-pair">
                        <label class="hkp-bd-line"><span>{{#str}}birthdays_group, local_oksigeniahechauka{{/str}}</span><input id="hkp-bd-group" name="group" maxlength="60" autocomplete="off"></label>
                        <label class="hkp-bd-line"><span>{{#str}}birthdays_idnumber, local_oksigeniahechauka{{/str}}</span><input id="hkp-bd-idnumber" name="idnumber" maxlength="100" autocomplete="off"></label>
                    </div>
                </div>
                <label class="hkp-bd-snap"><input class="visually-hidden sr-only" type="file" id="hkp-bd-photo" name="photo" accept="image/jpeg,image/png" data-bd-face><span class="hkp-bd-snap-face"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8.5h3l1.6-2.5h6.8L17 8.5h3v10H4z"/><circle cx="12" cy="13" r="3.2"/></svg></span><span>{{#str}}birthdays_photo, local_oksigeniahechauka{{/str}}</span></label>
                <div class="hkp-bd-add"><button type="submit" class="btn btn-primary">{{#str}}birthdays_add_button, local_oksigeniahechauka{{/str}}</button></div>
            </form>
            <h3 class="hkp-label hkp-bd-many">{{#str}}birthdays_many, local_oksigeniahechauka{{/str}}</h3>
            <div class="hkp-bd-ways">
                <form method="post" action="{{action}}" enctype="multipart/form-data" class="hkp-bd-ways-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="import">
                    <div class="hkp-bd-way">
                        <span class="hkp-bd-way-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M3.5 9h17M3.5 14.5h17M9.5 3.5v17"/></svg></span>
                        <h4>{{#str}}birthdays_sheet, local_oksigeniahechauka{{/str}}</h4>
                        <p class="hkp-hint">{{#str}}birthdays_sheet_help, local_oksigeniahechauka{{/str}} <a href="{{modelurl}}" download>{{#str}}birthdays_model, local_oksigeniahechauka{{/str}}</a></p>
                        <div class="hkp-bd-way-do"><label class="btn btn-outline-secondary hkp-bd-file"><input class="visually-hidden sr-only" type="file" id="hkp-bd-sheet" name="sheet" accept=".csv,text/csv,text/plain" data-bd-chosen>{{#str}}birthdays_choose_sheet, local_oksigeniahechauka{{/str}}</label><small class="hkp-bd-chosen" aria-live="polite"></small></div>
                        <button type="submit" class="btn btn-primary" data-bd-when-chosen hidden>{{#str}}birthdays_import_button, local_oksigeniahechauka{{/str}}</button>
                    </div>
                    <div class="hkp-bd-way">
                        <span class="hkp-bd-way-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6.5h11M9 12h11M9 17.5h11"/><circle cx="4.5" cy="6.5" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="17.5" r="1"/></svg></span>
                        <h4><label for="hkp-bd-list">{{#str}}birthdays_import, local_oksigeniahechauka{{/str}}</label></h4>
                        <textarea class="form-control" id="hkp-bd-list" name="list" rows="4" aria-describedby="hkp-bd-list-help"></textarea>
                        <p class="hkp-hint" id="hkp-bd-list-help">{{#str}}birthdays_import_help, local_oksigeniahechauka{{/str}}</p>
                        <button type="submit" class="btn btn-outline-secondary">{{#str}}birthdays_import_button, local_oksigeniahechauka{{/str}}</button>
                    </div>
                </form>
                <form method="post" action="{{action}}" enctype="multipart/form-data" class="hkp-bd-ways-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="photos">
                    <div class="hkp-bd-way">
                        <span class="hkp-bd-way-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6.5" y="3.5" width="14" height="12" rx="2"/><path d="M3.5 8v10.5a2 2 0 0 0 2 2H16"/><circle cx="11" cy="8" r="1.5"/><path d="m20.5 13-4-4-6.5 6.5"/></svg></span>
                        <h4>{{#str}}birthdays_photos, local_oksigeniahechauka{{/str}}</h4>
                        <p class="hkp-hint">{{#str}}birthdays_photos_help, local_oksigeniahechauka{{/str}}</p>
                        <p class="hkp-hint">{{#str}}birthdays_photos_moodle, local_oksigeniahechauka{{/str}} {{#moodlepictures}}{{#str}}birthdays_photos_moodle_here, local_oksigeniahechauka{{/str}} <a href="{{moodlepictures}}">{{#str}}uploadpictures, tool_uploaduser{{/str}}</a>.{{/moodlepictures}}{{^moodlepictures}}{{#str}}birthdays_photos_moodle_admin, local_oksigeniahechauka{{/str}}{{/moodlepictures}}</p>
                        <div class="hkp-bd-way-do"><label class="btn btn-outline-secondary hkp-bd-file"><input class="visually-hidden sr-only" type="file" id="hkp-bd-photos" name="photos[]" accept="image/jpeg,image/png" multiple data-bd-chosen data-many="{{#str}}birthdays_chosen_many, local_oksigeniahechauka, %d{{/str}}">{{#str}}birthdays_choose_photos, local_oksigeniahechauka{{/str}}</label><small class="hkp-bd-chosen" aria-live="polite"></small></div>
                        <button type="submit" class="btn btn-primary" data-bd-when-chosen hidden>{{#str}}birthdays_photos_button, local_oksigeniahechauka{{/str}}</button>
                    </div>
                </form>
            </div>
        </section>
        <section class="hkp-fs" aria-labelledby="hkp-bd-people">
            <h2 id="hkp-bd-people" class="hkp-label hkp-section-label">{{#str}}birthdays_list, local_oksigeniahechauka, {{count}}{{/str}}</h2>
            {{^haspeople}}<p class="hkp-hint">{{#str}}birthdays_list_empty, local_oksigeniahechauka{{/str}}</p>{{/haspeople}}
            {{#haspeople}}{{#hasunlinked}}<div class="hkp-bd-tools"><p class="hkp-hint">{{#str}}birthdays_unlinked_count, local_oksigeniahechauka, {{unlinked}}{{/str}}</p><div class="form-switch form-check"><input class="form-check-input" type="checkbox" role="switch" id="hkp-bd-onlyunlinked"><label class="form-check-label" for="hkp-bd-onlyunlinked">{{#str}}birthdays_only_unlinked, local_oksigeniahechauka{{/str}}</label></div><form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="relink"><button type="submit" class="btn btn-sm btn-outline-secondary">{{#str}}birthdays_relink, local_oksigeniahechauka{{/str}}</button></form></div>{{/hasunlinked}}<ul class="hkp-bd-list">{{#people}}<li class="hkp-bd-row"{{#linked}} data-linked="1"{{/linked}}><span class="hkp-bd-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="" loading="lazy">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span><span class="hkp-bd-who"><b>{{name}}</b>{{#group}} <small>{{group}}</small>{{/group}}{{#idnumber}} <small>· {{#str}}birthdays_row_idnumber, local_oksigeniahechauka, {{idnumber}}{{/str}}</small>{{/idnumber}}{{#linked}} <small class="hkp-bd-account">· {{#str}}birthdays_account, local_oksigeniahechauka, {{account}}{{/str}}</small>{{/linked}}</span><span class="hkp-bd-date">{{date}}</span><div class="hkp-bd-acts"><button type="button" class="btn btn-sm btn-outline-secondary hkp-bd-link" data-hkp-link="{{id}}" data-name="{{name}}" data-user="{{userid}}" data-account="{{account}}" aria-label="{{#cleanstr}}birthdays_link_label, local_oksigeniahechauka, {{name}}{{/cleanstr}}">{{#linked}}{{#str}}birthdays_link_change, local_oksigeniahechauka{{/str}}{{/linked}}{{^linked}}{{#str}}birthdays_link, local_oksigeniahechauka{{/str}}{{/linked}}</button><form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{id}}"><button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="{{#str}}birthdays_delete, local_oksigeniahechauka, {{name}}{{/str}}">×</button></form></div></li>{{/people}}</ul>{{/haspeople}}
        </section>
    </div>
    <dialog class="hkp-dialog is-narrow" id="hkp-link-dialog" aria-labelledby="hkp-lk-h">
        <header><h2 id="hkp-lk-h"></h2><button type="button" class="btn btn-icon" data-hkp-close aria-label="{{#str}}closebuttontitle{{/str}}">{{{icons.x}}}</button></header>
        <div class="hkp-dialog-body">
            <p class="hkp-hint">{{#str}}birthdays_link_help, local_oksigeniahechauka{{/str}}</p>
            <p class="hkp-bd-current" hidden><span></span> <button type="button" class="btn btn-sm btn-outline-secondary" data-hkp-unlink>{{#str}}birthdays_unlink, local_oksigeniahechauka{{/str}}</button></p>
            <div class="hkp-search" data-list="any" data-group="0">{{{icons.search}}}<input class="form-control" role="combobox" aria-expanded="false" aria-controls="hkp-lb-link" aria-autocomplete="list" placeholder="{{#str}}birthdays_link_search, local_oksigeniahechauka{{/str}}" aria-label="{{#str}}birthdays_link_search, local_oksigeniahechauka{{/str}}" autocomplete="off" spellcheck="false"><ul class="hkp-listbox" id="hkp-lb-link" role="listbox" hidden></ul></div>
        </div>
        <footer><button type="button" class="btn btn-outline-secondary" data-hkp-close>{{#str}}cancel{{/str}}</button></footer>
    </dialog>
    <form method="post" action="{{action}}" id="hkp-link-form" hidden><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="link"><input type="hidden" name="id" value=""><input type="hidden" name="user" value=""></form>
</div>
{{#js}}
(function() {
    var page = document.getElementById('hkp-birthdays-page');
    if (!page) {
        return;
    }
    var words = JSON.parse(page.getAttribute('data-strings') || '{}');
    var people = page.getAttribute('data-people');
    var sesskey = page.getAttribute('data-sesskey');
    var dialog = page.querySelector('#hkp-link-dialog');
    var form = page.querySelector('#hkp-link-form');
    // A switch or a choice saves as it changes; without a script, its button is there. Turning Cifra on goes the whole
    // way (it reads the pupils at once and says what it found), and if a save fails the button comes back.
    page.querySelectorAll('form[data-saves]').forEach(function(saves) {
        var button = saves.querySelector('[data-without-script]');
        var said = saves.querySelector('.hkp-saved-note');
        var timer = 0;
        button.hidden = true;
        saves.addEventListener('change', function(e) {
            if (e.target.name === 'cifra' && e.target.checked) {
                saves.submit();
                return;
            }
            var body = new FormData(saves);
            body.append('quiet', '1');
            fetch(saves.getAttribute('action'), {method: 'POST', body: body, credentials: 'same-origin'}).then(function(res) {
                return res.json();
            }).then(function(answer) {
                if (!answer.ok) {
                    throw new Error(answer.message);
                }
                said.hidden = false;
                clearTimeout(timer);
                timer = setTimeout(function() {
                    said.hidden = true;
                }, 2500);
                return answer;
            }).catch(function() {
                button.hidden = false;
            });
        });
    });
    // A file chosen says its name (or how many), and only then its button comes.
    page.querySelectorAll('[data-bd-chosen]').forEach(function(input) {
        input.addEventListener('change', function() {
            var way = input.closest('.hkp-bd-way');
            var n = input.files ? input.files.length : 0;
            var text = '';
            if (n > 1) {
                text = input.getAttribute('data-many').replace('%d', n);
            } else if (n) {
                text = input.files[0].name;
            }
            way.querySelector('.hkp-bd-chosen').textContent = text;
            way.querySelector('[data-bd-when-chosen]').hidden = !n;
        });
    });
    // The photo of someone new, seen on the page before it is added.
    var face = page.querySelector('[data-bd-face]');
    if (face) {
        face.addEventListener('change', function() {
            var file = face.files && face.files[0];
            var art = face.parentNode.querySelector('.hkp-bd-snap-face');
            if (!file) {
                return;
            }
            var img = document.createElement('img');
            img.alt = '';
            img.src = URL.createObjectURL(file);
            art.textContent = '';
            art.appendChild(img);
        });
    }
    if (!dialog || !form) {
        return;
    }
    var send = function(user) {
        form.querySelector('[name="user"]').value = user;
        form.submit();
    };
    // Only who has no account yet: the ones left to link by hand.
    var only = page.querySelector('#hkp-bd-onlyunlinked');
    if (only) {
        only.addEventListener('change', function() {
            page.querySelectorAll('.hkp-bd-row[data-linked]').forEach(function(row) {
                row.hidden = only.checked;
            });
        });
    }
    // The dialog of a person of the list: their account now, and the search for another.
    var current = dialog.querySelector('.hkp-bd-current');
    var input = dialog.querySelector('.hkp-search input');
    var list = dialog.querySelector('.hkp-listbox');
    page.querySelectorAll('[data-hkp-link]').forEach(function(b) {
        b.addEventListener('click', function() {
            form.querySelector('[name="id"]').value = b.getAttribute('data-hkp-link');
            dialog.querySelector('#hkp-lk-h').textContent = (words.title || '').replace('{name}', b.getAttribute('data-name'));
            var account = b.getAttribute('data-account');
            current.hidden = !account;
            current.querySelector('span').textContent = account;
            input.value = '';
            list.hidden = true;
            list.textContent = '';
            dialog.showModal();
            input.focus();
        });
    });
    dialog.querySelectorAll('[data-hkp-close]').forEach(function(b) {
        b.addEventListener('click', function() {
            dialog.close();
        });
    });
    dialog.querySelector('[data-hkp-unlink]').addEventListener('click', function() {
        send(0);
    });
    var timer = null;
    var options = [];
    var at = -1;
    var close = function() {
        list.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        at = -1;
    };
    var mark = function(k) {
        options.forEach(function(o, i) {
            o.setAttribute('aria-selected', i === k ? 'true' : 'false');
        });
        at = k;
        if (options[k]) {
            input.setAttribute('aria-activedescendant', options[k].id);
        }
    };
    var show = function(found) {
        list.textContent = '';
        options = [];
        found.forEach(function(p, i) {
            var li = document.createElement('li');
            li.id = 'hkp-opt-link-' + i;
            li.setAttribute('role', 'option');
            li.setAttribute('data-user', p.id);
            li.setAttribute('aria-selected', 'false');
            var av = document.createElement('span');
            av.className = 'hkp-av';
            av.setAttribute('aria-hidden', 'true');
            av.textContent = p.initials;
            var text = document.createElement('span');
            text.textContent = p.name;
            var small = document.createElement('small');
            small.textContent = p.detail;
            text.appendChild(small);
            li.appendChild(av);
            li.appendChild(text);
            li.addEventListener('mousedown', function(e) {
                e.preventDefault();
                send(p.id);
            });
            list.appendChild(li);
            options.push(li);
        });
        if (!found.length) {
            var none = document.createElement('li');
            none.setAttribute('aria-disabled', 'true');
            none.textContent = words.none;
            list.appendChild(none);
        }
        list.hidden = false;
        input.setAttribute('aria-expanded', 'true');
    };
    input.addEventListener('input', function() {
        clearTimeout(timer);
        if (input.value.trim().length < 2) {
            close();
            return;
        }
        timer = setTimeout(function() {
            fetch(people + '?q=' + encodeURIComponent(input.value.trim()) + '&list=any&sesskey=' + sesskey,
                {credentials: 'same-origin'}).then(function(r) {
                return r.json();
            }).then(show).catch(close);
        }, 250);
    });
    input.addEventListener('keydown', function(e) {
        if (list.hidden) {
            return;
        }
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            mark(Math.min(options.length - 1, at + 1));
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            mark(Math.max(0, at - 1));
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (options[at]) {
                send(options[at].getAttribute('data-user'));
            }
        } else if (e.key === 'Escape') {
            close();
        }
    });
    input.addEventListener('blur', function() {
        setTimeout(close, 150);
    });
})();
{{/js}}
