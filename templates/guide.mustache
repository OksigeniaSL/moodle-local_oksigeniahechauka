{{!
    @template local_oksigeniahechauka/guide

    The guide inside the panel: the «How it works» pieces, each opening in a dialog, and the printed guide to download.

    Example context (json):
    {
        "tabs": [], "hastabs": false, "back": "#", "backicon": "", "pdf": "#", "pdficon": "",
        "pieces": [{"piece": "publicar", "title": "Cómo se publica", "desc": "Un aviso o una foto, cuándo y dónde.",
            "thumb": "https://example.com/help/publicar/es/portada.webp", "thumbdark": "https://example.com/help/publicar/es/portada-dark.webp", "base": "#", "lang": "es", "ui": "{}", "length": "≈ 40 s", "icon": ""}]
    }
}}
<div class="hkp hkp-guide-page">
    {{^hastabs}}<a class="hkp-back" href="{{back}}">{{{backicon}}}{{#str}}panel_title, local_oksigeniahechauka{{/str}}</a>{{/hastabs}}
    <header class="hkp-head">
        <div class="hkp-head-title">
            <h1>{{#str}}guide_title, local_oksigeniahechauka{{/str}}</h1>
            <p class="hkp-head-sub">{{#str}}guide_sub, local_oksigeniahechauka{{/str}}</p>
        </div>
        {{#pdf}}<div class="hkp-head-actions"><a class="btn btn-outline-secondary hkp-guide-pdf" href="{{pdf}}" target="_blank" rel="noopener">{{{pdficon}}}{{#str}}guide_pdf, local_oksigeniahechauka{{/str}}</a></div>{{/pdf}}
    </header>
    {{#hastabs}}
    <nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">
        {{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}
    </nav>
    {{/hastabs}}
    <ul class="hkp-howto-list">
        {{#pieces}}
        <li id="{{piece}}">
            <button type="button" class="hkp-howto-card" data-hkp-howto="{{piece}}" data-title="{{title}}" data-base="{{base}}" data-lang="{{lang}}" data-ui="{{ui}}">
                <span class="hkp-howto-thumb"><img class="is-light" src="{{thumb}}" alt="" loading="lazy"><img class="is-dark" src="{{thumbdark}}" alt="" loading="lazy"><span class="hkp-howto-play">{{{icon}}}</span></span>
                <b>{{title}}</b>
                <span>{{desc}}</span>
                <small>{{length}}</small>
            </button>
        </li>
        {{/pieces}}
    </ul>
</div>
