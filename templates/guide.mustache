{{!
    @template local_oksigeniahechauka/guide

    The user's guide inside the panel.

    Example context (json):
    {
        "tabs": [], "hastabs": false, "back": "#", "backicon": "", "pdf": "#", "pdficon": "",
        "body": "<h2>Qué es Hechauka</h2><p>Las pantallas informativas de un centro.</p>"
    }
}}
<div class="hkp hkp-guide-page">
    {{^hastabs}}<a class="hkp-back" href="{{back}}">{{{backicon}}}{{#str}}panel_title, local_oksigeniahechauka{{/str}}</a>{{/hastabs}}
    <header class="hkp-head">
        <div class="hkp-head-title">
            <h1>{{#str}}guide_title, local_oksigeniahechauka{{/str}}</h1>
            <p class="hkp-head-sub">{{#str}}guide_sub, local_oksigeniahechauka{{/str}}</p>
        </div>
        {{#pdf}}<div class="hkp-head-actions"><a class="btn btn-outline-secondary hkp-guide-pdf" href="{{pdf}}" target="_blank" rel="noopener">{{{pdficon}}}{{#str}}guide_pdf, local_oksigeniahechauka{{/str}}</a></div>{{/pdf}}
    </header>
    {{#hastabs}}
    <nav class="hkp-tabs" aria-label="{{#str}}tabs_label, local_oksigeniahechauka{{/str}}">
        {{#tabs}}<a href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{{icon}}}{{label}}</a>{{/tabs}}
    </nav>
    {{/hastabs}}
    <article class="hkp-guide">{{{body}}}</article>
</div>
