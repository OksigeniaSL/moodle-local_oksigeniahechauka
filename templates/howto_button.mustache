{{!
    @template local_oksigeniahechauka/howto_button

    The button that opens a «How it works» piece (panel/ayuda.js).

    Example context (json):
    {
        "piece": "publicar", "title": "Cómo se publica", "base": "#", "lang": "es", "ui": "{}", "length": "≈ 40 s", "icon": ""
    }
}}
<button type="button" class="hkp-howto" data-hkp-howto="{{piece}}" data-title="{{title}}" data-base="{{base}}" data-lang="{{lang}}" data-ui="{{ui}}">{{{icon}}}<span>{{#str}}howto, local_oksigeniahechauka{{/str}}</span><small>{{length}}</small></button>
