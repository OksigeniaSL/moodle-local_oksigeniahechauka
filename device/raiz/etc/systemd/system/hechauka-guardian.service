[Unit]
Description=Hechauka: the guardian of the screen
After=systemd-tmpfiles-setup.service
# Five failures in five minutes: what just went in goes back (rescate.py, never replaced along with the guardian).
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=hechauka-rescate.service

[Service]
ExecStart=/usr/bin/python3 -B /usr/local/lib/hechauka/guardian.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
