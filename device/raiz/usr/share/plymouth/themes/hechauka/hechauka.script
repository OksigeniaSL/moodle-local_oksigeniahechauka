# The boot of a Hechauka screen: the mark with its ribbon going from one screen to the other, in a loop, and under it the word
# with «por OKSIGENIA», at the size of the screen.
Window.SetBackgroundTopColor(0.039, 0.180, 0.314);
Window.SetBackgroundBottomColor(0.039, 0.180, 0.314);

width = Window.GetWidth();
height = Window.GetHeight();
scale = Math.Min(width, height) / 1080;
middle_x = Window.GetX() + width / 2;
middle_y = Window.GetY() + height / 2;

for (i = 1; i <= 24; i++) {
    if (i < 10) {
        name = "animation-000" + i + ".png";
    } else {
        name = "animation-00" + i + ".png";
    }
    frame[i - 1] = Image(name).Scale(360 * scale, 360 * scale);
}
mark = Sprite(frame[0]);
mark.SetPosition(middle_x - 180 * scale, middle_y - 290 * scale, 1);

word = Image("palabra.png");
word = word.Scale(word.GetWidth() * scale, word.GetHeight() * scale);
name_sprite = Sprite(word);
name_sprite.SetPosition(middle_x - word.GetWidth() / 2, middle_y + 100 * scale, 1);

# It refreshes 50 times a second: a new frame each four, twelve a second.
tick = 0;
fun refresh() {
    tick++;
    mark.SetImage(frame[Math.Int(tick / 4) % 24]);
}
Plymouth.SetRefreshFunction(refresh);
